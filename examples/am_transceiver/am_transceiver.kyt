project:
  format_version: 1
  name: DSB-AM transceiver (on-chip, real blocks) — TX modulate + RX demodulate
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: gain
  type: GainBlock
  library: lattrex.official
  params:
    gain: 2.0
    gain_range: 15
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 6, y: 2, face: east}
- name: lowpassfilter
  type: LowPassFilter
  library: lattrex.official
  params:
    gain: 1.0
    samp_rate: 32000.0
    cutoff_freq: 2000.0
    transition_width: 1000.0
    window: hamming
    beta: 6.76
    decimation: 1
    interpolation: 1
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 3, y: 3, face: south}
    - {cell_id: 1, x: 3, y: 4, face: south}
    - {cell_id: 2, x: 3, y: 5, face: south}
    - {cell_id: 3, x: 3, y: 6, face: east}
    - {cell_id: 4, x: 4, y: 6, face: north}
    - {cell_id: 5, x: 4, y: 5, face: north}
    - {cell_id: 6, x: 4, y: 4, face: north}
    - {cell_id: 7, x: 4, y: 3, face: east}
    - {cell_id: 8, x: 5, y: 3, face: south}
    - {cell_id: 9, x: 5, y: 4, face: south}
    - {cell_id: 10, x: 5, y: 5, face: south}
    - {cell_id: 11, x: 5, y: 6, face: east}
    - {cell_id: 12, x: 6, y: 6, face: north}
    - {cell_id: 13, x: 6, y: 5, face: north}
    - {cell_id: 14, x: 6, y: 4, face: north}
    - {cell_id: 15, x: 6, y: 3, face: north}
- name: iqupconvert
  type: IQUpconvertBlock
  library: lattrex.official
  params:
    sample_rate: 32000.0
    frequency: 6000.0
  placement:
    chip: 0
    cells:
    - {cell_id: phase, x: 1, y: 1, face: east}
    - {cell_id: sin_fold, x: 2, y: 1, face: east}
    - {cell_id: cos_fold, x: 3, y: 1, face: east}
    - {cell_id: table_sin, x: 4, y: 1, face: south}
    - {cell_id: table_cos, x: 4, y: 2, face: west}
    - {cell_id: upmix, x: 3, y: 2, face: west}
    - {cell_id: transit_unlock_0, x: 2, y: 2, face: west}
    - {cell_id: transit_unlock_1, x: 1, y: 2, face: north}
- name: iqupconvert_2
  type: IQUpconvertBlock
  library: lattrex.official
  params:
    sample_rate: 32000.0
    frequency: 6000.0
  placement:
    chip: 0
    cells:
    - {cell_id: phase, x: 1, y: 9, face: east}
    - {cell_id: sin_fold, x: 2, y: 9, face: east}
    - {cell_id: cos_fold, x: 3, y: 9, face: east}
    - {cell_id: table_sin, x: 4, y: 9, face: south}
    - {cell_id: table_cos, x: 4, y: 10, face: west}
    - {cell_id: upmix, x: 3, y: 10, face: west}
    - {cell_id: transit_unlock_0, x: 2, y: 10, face: west}
    - {cell_id: transit_unlock_1, x: 1, y: 10, face: north}
connections:
- name: net1
  from: {block: gain, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 6, y: 2}
  - {x: 7, y: 2}
  - {x: 8, y: 2}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 5
- name: net2
  from: {block: lowpassfilter, port: out}
  to: {block: gain, port: sample}
  route:
  - {x: 6, y: 3}
  - {x: 6, y: 2}
- name: net3
  from: {block: iqupconvert, port: out}
  to: {block: lowpassfilter, port: sample}
  route:
  - {x: 3, y: 2}
  - {x: 3, y: 3}
- name: net4
  from: {block: iqupconvert_2, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 3, y: 10}
  - {x: 3, y: 11}
  - {x: 4, y: 11}
  - {x: 5, y: 11}
  - {x: 6, y: 11}
  - {x: 7, y: 11}
  - {x: 8, y: 11}
  - {x: 9, y: 11}
  - {x: 9, y: 10}
  - {x: 9, y: 9}
  - {x: 9, y: 8}
  - {x: 9, y: 7}
  - {x: 9, y: 6}
  - {x: 9, y: 5}
  - {x: 9, y: 4}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 10
- name: net5
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: iqupconvert, port: xi}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  stream_id: rx
- name: net6
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: iqupconvert_2, port: xi}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 0, y: 3}
  - {x: 0, y: 4}
  - {x: 0, y: 5}
  - {x: 0, y: 6}
  - {x: 0, y: 7}
  - {x: 0, y: 8}
  - {x: 0, y: 9}
  stream_id: tx
