project:
  format_version: 1
  name: Feedforward comb (placed audio effect)
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: delay
  type: DelayBlock
  library: lattrex.official
  params:
    delay: 5
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 2, y: 0, face: south}
    orientation:
    - cw
- name: gain
  type: GainBlock
  library: lattrex.official
  params:
    gain: 0.3
    gain_range: 15
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 3, y: 0, face: south}
    orientation:
    - cw
- name: subtract
  type: SubtractBlock
  library: lattrex.official
  params:
    num_inputs: 2
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 4, y: 0, face: east}
connections:
- name: net1
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: subtract, port: a0}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  - {x: 1, y: 1}
  - {x: 2, y: 1}
  - {x: 3, y: 1}
  - {x: 4, y: 1}
  - {x: 4, y: 0}
  stream_id: fx
  entry_override: 12
- name: net2
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: delay, port: sample}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  stream_id: fx
- name: net3
  from: {block: delay, port: out}
  to: {block: gain, port: sample}
  route: abutment
- name: net4
  from: {block: gain, port: out}
  to: {block: subtract, port: a1}
  route: abutment
  entry_override: 12
- name: net5
  from: {block: subtract, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 4, y: 0}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 14
