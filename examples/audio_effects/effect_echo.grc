options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'A placed feedforward ECHO (x + 0.5*delay8(x), a single-fire Add
      join), 0.5 headroom scale, butter(2, 0.15) IIR biquad tone shaping, keep-one-in-2
      decimation. Golden: the IDENTICAL stock-GNU-Radio chain within a DERIVED per-block
      bound.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: effect_echo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Echo + tone shaping (placed audio effect)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: imports
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 68
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: audio sample rate
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: sig
  id: variable
  parameters:
    comment: a 330 Hz tone + a faint 2.2 kHz overtone (max 0.55 FS)
    value: '[0.5*math.sin(2*math.pi*330*t/8000) + 0.05*math.sin(2*math.pi*2200*t/8000)
      for t in range(400)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 320
    - 12
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: samples per burst
    value: len(sig)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 620
    - 12
    rotation: 0
    state: enabled
- name: iir_b
  id: variable
  parameters:
    comment: butter(2, 0.15) numerator
    value: '[0.04125353724172031, 0.08250707448344062, 0.04125353724172031]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 12
    rotation: 0
    state: enabled
- name: iir_a
  id: variable
  parameters:
    comment: butter(2, 0.15) denominator tail [a1, a2]
    value: '[-1.3489677452527948, 0.5139818942196759]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 980
    - 12
    rotation: 0
    state: enabled
- name: fx_vec
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: float
    vector: sig
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 40
    - 220
    rotation: 0
    state: enabled
- name: fx_in
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    burst_len: burst_len
    complex_in: float
    device_id: '"kyttar_0"'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"fx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 190
    - 212
    rotation: 0
    state: enabled
- name: echo_delay
  id: kyttar_delay
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    delay: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 370
    - 300
    rotation: 0
    state: enabled
- name: echo_gain
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    gain: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 300
    rotation: 0
    state: enabled
- name: echo_add
  id: kyttar_add
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    num_inputs: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 630
    - 212
    rotation: 0
    state: enabled
- name: wet_gain
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    gain: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 212
    rotation: 0
    state: enabled
- name: biquad
  id: kyttar_iir_biquad
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    b_coeffs: iir_b
    a_coeffs: iir_a
    fftaps: None
    fbtaps: None
    oldstyle: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 890
    - 212
    rotation: 0
    state: enabled
- name: decim
  id: kyttar_keep_one_in_n
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    n: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1020
    - 212
    rotation: 0
    state: enabled
- name: fx_out
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'True'
    stream_id: '"fx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1150
    - 204
    rotation: 0
    state: enabled
- name: scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    legend: 'True'
    autoscale: 'False'
    axislabels: 'True'
    name: '"echo -> biquad -> decimated"'
    nconnections: '1'
    size: burst_len//2
    srate: samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
