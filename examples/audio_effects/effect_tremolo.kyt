project:
  format_version: 1
  name: NCO tremolo (placed audio effect)
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: nco
  type: NCOBlock
  library: lattrex.official
  params:
    sample_rate: 8000.0
    frequency: 250.0
    amplitude: 0.45
    offset: 0.0
    phase: 0.0
    waveform: cos
    pipeline_lock: false
  placement:
    chip: 0
    cells:
    - {cell_id: phase, x: 1, y: 3, face: south}
    - {cell_id: sin_fold, x: 1, y: 4, face: south}
    - {cell_id: sin_even, x: 1, y: 5, face: south}
    - {cell_id: sin_odd, x: 1, y: 6, face: south}
    - {cell_id: sin_interp, x: 1, y: 7, face: east}
    - {cell_id: cos_fold, x: 2, y: 7, face: north}
    - {cell_id: cos_even, x: 2, y: 6, face: north}
    - {cell_id: cos_odd, x: 2, y: 5, face: north}
    - {cell_id: cos_interp, x: 2, y: 4, face: north}
    - {cell_id: emit, x: 2, y: 3, face: east}
- name: complextoreal
  type: ComplexToRealBlock
  library: lattrex.official
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 2, y: 2, face: west}
    orientation:
    - mirror_h
- name: addconst
  type: AddConstBlock
  library: lattrex.official
  params:
    const: 0.5
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 2, y: 1, face: east}
- name: multiply
  type: MultiplyBlock
  library: lattrex.official
  params:
    num_inputs: 2
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 2, y: 0, face: north}
    orientation:
    - ccw
    - mirror_h
connections:
- name: net1
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: multiply, port: a0}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  stream_id: fx
  entry_override: 18
- name: net2
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: nco, port: xi}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  - {x: 1, y: 1}
  - {x: 1, y: 2}
  - {x: 1, y: 3}
  stream_id: fx
- name: net3
  from: {block: nco, port: yi}
  to: {block: complextoreal, port: re}
  route: abutment
- name: net4
  from: {block: complextoreal, port: out}
  to: {block: addconst, port: x}
  route: abutment
- name: net5
  from: {block: addconst, port: out}
  to: {block: multiply, port: a1}
  route: abutment
  entry_override: 18
- name: net6
  from: {block: multiply, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 2, y: 0}
  - {x: 3, y: 0}
  - {x: 4, y: 0}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 14
- name: net7
  from: {block: nco, port: yq}
  to: {block: complextoreal, port: im}
  route: abutment
