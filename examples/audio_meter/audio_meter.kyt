project:
  format_version: 1
  name: Receiver audio tail + S-meter (duplex on one array)
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: dcblocker
  type: DCBlockerBlock
  library: lattrex.official
  params:
    length: 32
    long_form: false
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 1, y: 1, face: south}
    - {cell_id: 1, x: 1, y: 2, face: south}
    - {cell_id: 2, x: 1, y: 3, face: south}
    - {cell_id: 3, x: 1, y: 4, face: east}
    - {cell_id: 4, x: 2, y: 4, face: north}
    - {cell_id: 5, x: 2, y: 3, face: north}
    - {cell_id: 6, x: 2, y: 2, face: north}
    - {cell_id: 7, x: 2, y: 1, face: east}
    - {cell_id: 8, x: 3, y: 1, face: south}
    - {cell_id: 9, x: 3, y: 2, face: south}
    - {cell_id: 10, x: 3, y: 3, face: south}
    - {cell_id: 11, x: 3, y: 4, face: east}
    - {cell_id: 12, x: 4, y: 4, face: north}
- name: agc
  type: AGCBlock
  library: lattrex.official
  params:
    rate: 0.02
    reference: 0.3
    gain: 0.999
    max_gain: 0.999
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 4, y: 5, face: south}
    orientation:
    - cw
- name: bandrejectfilter
  type: BandRejectFilter
  library: lattrex.official
  params:
    gain: 0.999
    samp_rate: 8000.0
    low_cutoff_freq: 3300.0
    high_cutoff_freq: 3700.0
    transition_width: 400.0
    window: hamming
    beta: 6.76
    decimation: 1
    interpolation: 1
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 6, y: 5, face: east}
    - {cell_id: 1, x: 7, y: 5, face: east}
    - {cell_id: 2, x: 8, y: 5, face: east}
    - {cell_id: 3, x: 9, y: 5, face: north}
    - {cell_id: 4, x: 9, y: 4, face: west}
    - {cell_id: 5, x: 8, y: 4, face: west}
    - {cell_id: 6, x: 7, y: 4, face: west}
    - {cell_id: 7, x: 6, y: 4, face: north}
    - {cell_id: 8, x: 6, y: 3, face: east}
    - {cell_id: 9, x: 7, y: 3, face: east}
    - {cell_id: 10, x: 8, y: 3, face: east}
    orientation:
    - ccw
- name: squelch
  type: SquelchBlock
  library: lattrex.official
  params:
    db: -25.0
    alpha: 0.01
    ramp: 0
    gate: false
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 2, face: west}
    orientation:
    - mirror_h
- name: abs
  type: AbsBlock
  library: lattrex.official
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 4, y: 3, face: south}
    orientation:
    - cw
- name: movingaverage
  type: MovingAverageBlock
  library: lattrex.official
  params:
    length: 8
    scale: 0.125
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 4, y: 0, face: east}
    - {cell_id: 1, x: 5, y: 0, face: south}
    orientation:
    - mirror_v
- name: nlog10
  type: Nlog10Block
  library: lattrex.official
  params:
    n: 10.0
    k: 0.0
  placement:
    chip: 0
    cells:
    - {cell_id: norm, x: 7, y: 0, face: east}
    - {cell_id: poly, x: 8, y: 0, face: east}
- name: rms
  type: RMSBlock
  library: lattrex.official
  params:
    alpha: 0.0625
  placement:
    chip: 0
    cells:
    - {cell_id: pwr, x: 3, y: 7, face: south}
    - {cell_id: norm, x: 3, y: 8, face: east}
    - {cell_id: poly, x: 4, y: 8, face: north}
    - {cell_id: denorm, x: 4, y: 7, face: east}
connections:
- name: net1
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: dcblocker, port: sample}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  stream_id: audio
  src_complex: false
- name: net2
  from: {block: dcblocker, port: out}
  to: {block: agc, port: sample}
  route: abutment
- name: net3
  from: {block: agc, port: out}
  to: {block: bandrejectfilter, port: sample}
  route:
  - {x: 4, y: 5}
  - {x: 5, y: 5}
- name: net4
  from: {block: bandrejectfilter, port: out}
  to: {block: squelch, port: sample}
  route: abutment
- name: net5
  from: {block: squelch, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 8, y: 2}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 22
- name: net6
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: abs, port: x}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 0, y: 3}
  - {x: 0, y: 4}
  - {x: 0, y: 5}
  - {x: 0, y: 6}
  - {x: 1, y: 6}
  - {x: 2, y: 6}
  - {x: 3, y: 6}
  - {x: 4, y: 6}
  - {x: 5, y: 6}
  - {x: 5, y: 5}
  - {x: 5, y: 4}
  - {x: 5, y: 3}
  stream_id: meter
  src_complex: false
- name: net7
  from: {block: abs, port: out}
  to: {block: movingaverage, port: sample}
  route:
  - {x: 4, y: 3}
  - {x: 4, y: 2}
  - {x: 4, y: 1}
- name: net8
  from: {block: movingaverage, port: out}
  to: {block: nlog10, port: sample}
  route:
  - {x: 5, y: 0}
  - {x: 6, y: 0}
- name: net9
  from: {block: nlog10, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 3
- name: net10
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: rms, port: sample}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 0, y: 3}
  - {x: 0, y: 4}
  - {x: 0, y: 5}
  - {x: 0, y: 6}
  - {x: 1, y: 6}
  - {x: 2, y: 6}
  - {x: 3, y: 6}
  stream_id: rms
  src_complex: false
- name: net11
  from: {block: rms, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 4, y: 7}
  - {x: 5, y: 7}
  - {x: 5, y: 6}
  - {x: 5, y: 5}
  - {x: 5, y: 4}
  - {x: 5, y: 3}
  - {x: 5, y: 2}
  - {x: 5, y: 1}
  - {x: 6, y: 1}
  - {x: 7, y: 1}
  - {x: 8, y: 1}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 11
