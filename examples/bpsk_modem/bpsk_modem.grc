options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Full-duplex BPSK modem authored in GNU Radio (GRC-first workflow).
      The TX chain (PSK symbol mapper -> upsampler -> RRC pulse shaper -> I/Q upconvert)
      and the coherent RX chain (complex RRC matched filter -> complex Costas loop
      -> Gardner timing recovery -> BPSK slicer) live on ONE placeKYT array, sharing
      ONE input port (x16_in) and ONE output port (x16_out): both TX and RX source
      blocks map to x16_in and both sink blocks map to x16_out (the shared-port duplex).
      Built from the REAL DSP blocks so it IMPORTS into placeKYT (File -> Import GNURadio
      Flowgraph): all 8 blocks get placed and the logical nets are recovered; the
      headless engine.bpsk_modem_demo proves BER 0 on the built bitstream.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: bpsk_modem
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Full-duplex BPSK modem (TX + coherent RX on one array)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: carrier
  id: variable
  parameters:
    comment: TX carrier frequency
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 12]
    rotation: 0
    state: enabled
- name: n_bits
  id: variable
  parameters:
    comment: TX bits in the burst
    value: '64'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 12]
    rotation: 0
    state: enabled
- name: n_syms
  id: variable
  parameters:
    comment: RX symbols in the burst
    value: '120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: TX passband sample rate
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: TX samples per symbol
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: costas
  id: kyttar_costas_loop
  parameters:
    affinity: ''
    alias: ''
    comment: "Complex Costas carrier recovery \u2014 placed on chip"
    damping: '1.0'
    device_id: '"kyttar_0"'
    loop_bw: '0.05'
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 440.0]
    rotation: 0
    state: enabled
- name: gardner
  id: kyttar_gardner_ted
  parameters:
    affinity: ''
    alias: ''
    comment: "Gardner timing recovery \u2014 placed on chip"
    complex: 'False'
    device_id: '"kyttar_0"'
    ki: '1'
    kp: '3'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 352.0]
    rotation: 0
    state: enabled
- name: import_stim
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: from gnuradio.kyttar import modem_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 12]
    rotation: 0
    state: enabled
- name: mapper
  id: kyttar_psk_symbol_mapper
  parameters:
    affinity: ''
    alias: ''
    comment: "PSK symbol mapper (BPSK) \u2014 placed on chip"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    modulation: '"bpsk"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 152.0]
    rotation: 0
    state: enabled
- name: mf
  id: kyttar_complex_rrc_matched_filter
  parameters:
    affinity: ''
    alias: ''
    alpha: '0.35'
    comment: "Complex RRC matched filter front end \u2014 placed on chip"
    decimation: '1'
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    span: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 336.0]
    rotation: 0
    state: enabled
- name: rrc
  id: kyttar_rrc_pulse_shaper
  parameters:
    affinity: ''
    alias: ''
    alpha: '0.35'
    comment: "RRC pulse shaper \u2014 placed on chip"
    device_id: '"kyttar_0"'
    io_type: complex
    maxoutbuf: '0'
    minoutbuf: '0'
    span: '8'
    sps: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 128.0]
    rotation: 0
    state: enabled
- name: rx_bits
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: "recovered bits \u2014 from the chip x16_out (stream 'rx')"
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: Signal 1
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Recovered bits"'
    nconnections: '1'
    size: stim.rx_bits_points(n_syms)
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: bit
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1696, 440.0]
    rotation: 0
    state: enabled
- name: rx_iq
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: RX RRC-BPSK I/Q burst (carrier+timing offset); finite, no repeat
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: complex
    vector: stim.rx_burst(n_syms)
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 368.0]
    rotation: 0
    state: enabled
- name: rx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: recovered bits -> placeKYT chip x16_out (shared duplex port, stream 'rx')
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'False'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 340.0]
    rotation: 0
    state: enabled
- name: rx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: stim.rx_burst_len(n_syms)
    comment: RX I/Q burst -> placeKYT chip x16_in (shared duplex port, stream 'rx')
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 340.0]
    rotation: 0
    state: enabled
- name: slicer
  id: kyttar_bpsk_slicer
  parameters:
    affinity: ''
    alias: ''
    comment: "BPSK slicer (recovered bits) \u2014 placed on chip"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1176, 448.0]
    rotation: 0
    state: enabled
- name: tx_bits
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: TX bit stimulus (one finite burst -> EOF dispatches it; no repeat)
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: float
    vector: stim.tx_bits(n_bits)
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [88, 168.0]
    rotation: 0
    state: enabled
- name: tx_passband
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: "TX passband (real) \u2014 recovered from the chip x16_out (stream 'tx')"
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: Signal 1
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"TX passband (real)"'
    nconnections: '1'
    size: stim.tx_pb_points(n_bits)
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1680, 208.0]
    rotation: 0
    state: enabled
- name: tx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: TX passband -> placeKYT chip x16_out (shared duplex port, stream 'tx')
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'False'
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 100.0]
    rotation: 0
    state: enabled
- name: tx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: n_bits
    comment: TX bits -> placeKYT chip x16_in (shared duplex port, stream 'tx')
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 148.0]
    rotation: 0
    state: enabled
- name: up
  id: kyttar_upsampler
  parameters:
    affinity: ''
    alias: ''
    comment: "Zero-stuff upsampler (sps) \u2014 placed on chip"
    device_id: '"kyttar_0"'
    io_type: complex
    maxoutbuf: '0'
    minoutbuf: '0'
    sps: sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 224.0]
    rotation: 0
    state: enabled
- name: upc
  id: kyttar_iq_upconvert
  parameters:
    affinity: ''
    alias: ''
    comment: "I/Q upconvert to real passband \u2014 placed on chip"
    device_id: '"kyttar_0"'
    frequency: '8000'
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1184, 224.0]
    rotation: 0
    state: enabled

connections:
- [costas, '0', gardner, '0']
- [gardner, '0', slicer, '0']
- [mapper, '0', up, '0']
- [mf, '0', costas, '0']
- [rrc, '0', upc, '0']
- [rx_iq, '0', rx_src, '0']
- [rx_sink, '0', rx_bits, '0']
- [rx_src, '0', mf, '0']
- [slicer, '0', rx_sink, '0']
- [tx_bits, '0', tx_src, '0']
- [tx_sink, '0', tx_passband, '0']
- [tx_src, '0', mapper, '0']
- [up, '0', rrc, '0']
- [upc, '0', tx_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
