project:
  format_version: 1
  name: Full-duplex BPSK modem (TX + coherent RX on one array)
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: complexcostasloop
  type: ComplexCostasLoopBlock
  library: lattrex.official
  params:
    loop_bw: 0.05
    damping: 1.0
    order: 2
    pipeline_lock: true
  placement:
    chip: 0
    cells:
    - {cell_id: phase, x: 1, y: 11, face: east}
    - {cell_id: sin_fold, x: 2, y: 11, face: east}
    - {cell_id: cos_fold, x: 3, y: 11, face: east}
    - {cell_id: table_sin, x: 4, y: 11, face: north}
    - {cell_id: table_cos, x: 4, y: 10, face: west}
    - {cell_id: rotate, x: 3, y: 10, face: west}
    - {cell_id: pd_pi, x: 2, y: 10, face: west}
    - {cell_id: transit_fb_0, x: 1, y: 10, face: south}
    orientation:
    - mirror_v
- name: gardnertimingrecovery
  type: GardnerTimingRecovery
  library: lattrex.official
  params:
    kp: 3
    ki: 1
    pipeline_lock: true
    complex: false
  placement:
    chip: 0
    cells:
    - {cell_id: resampler, x: 6, y: 10, face: east}
    - {cell_id: ted, x: 7, y: 10, face: south}
    - {cell_id: loop_filter, x: 7, y: 11, face: west}
    - {cell_id: period_relay, x: 6, y: 11, face: north}
- name: psksymbolmapper
  type: PSKSymbolMapperBlock
  library: lattrex.official
  params:
    modulation: bpsk
    symbol_table:
    dimension: 1
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 1, y: 1, face: east}
- name: complexrrcmatchedfilter
  type: ComplexRRCMatchedFilterBlock
  library: lattrex.official
  params:
    beta: 0.35
    sps: 2
    span: 8
    headroom_shift: 1
    decimation: 1
  placement:
    chip: 0
    cells:
    - {cell_id: head, x: 1, y: 7, face: east}
    - {cell_id: q0, x: 2, y: 7, face: east}
    - {cell_id: q1, x: 3, y: 7, face: east}
    - {cell_id: q2, x: 4, y: 7, face: east}
    - {cell_id: q3, x: 5, y: 7, face: east}
    - {cell_id: q4, x: 6, y: 7, face: south}
    - {cell_id: i0, x: 6, y: 8, face: west}
    - {cell_id: i1, x: 5, y: 8, face: west}
    - {cell_id: i2, x: 4, y: 8, face: west}
    - {cell_id: i3, x: 3, y: 8, face: west}
    - {cell_id: i4, x: 2, y: 8, face: west}
- name: rrcpulseshaper
  type: RRCPulseShaperBlock
  library: lattrex.official
  params:
    gain: 1.0
    sampling_freq: 4.0
    symbol_rate: 1.0
    alpha: 0.35
    ntaps: 33
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 5, y: 1, face: east}
    - {cell_id: 1, x: 6, y: 1, face: east}
    - {cell_id: 2, x: 7, y: 1, face: east}
    - {cell_id: 3, x: 8, y: 1, face: south}
    - {cell_id: 4, x: 8, y: 2, face: west}
    - {cell_id: 5, x: 7, y: 2, face: west}
    - {cell_id: 6, x: 6, y: 2, face: west}
- name: bpskslicer
  type: BPSKSlicerBlock
  library: lattrex.official
  params:
    out_mode: bit
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 9, face: east}
- name: upsampler
  type: UpsamplerBlock
  library: lattrex.official
  params:
    sps: 4
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 3, y: 1, face: east}
- name: iqupconvert
  type: IQUpconvertBlock
  library: lattrex.official
  params:
    sample_rate: 32000.0
    frequency: 8000.0
  placement:
    chip: 0
    cells:
    - {cell_id: phase, x: 1, y: 4, face: east}
    - {cell_id: sin_fold, x: 2, y: 4, face: east}
    - {cell_id: cos_fold, x: 3, y: 4, face: east}
    - {cell_id: table_sin, x: 4, y: 4, face: south}
    - {cell_id: table_cos, x: 4, y: 5, face: west}
    - {cell_id: upmix, x: 3, y: 5, face: west}
    - {cell_id: transit_unlock_0, x: 2, y: 5, face: west}
    - {cell_id: transit_unlock_1, x: 1, y: 5, face: north}
connections:
- name: net1
  from: {block: complexcostasloop, port: yi_tap}
  to: {block: gardnertimingrecovery, port: xi}
  route:
  - {x: 3, y: 10}
  - {x: 3, y: 9}
  - {x: 4, y: 9}
  - {x: 5, y: 9}
  - {x: 5, y: 10}
- name: net2
  from: {block: gardnertimingrecovery, port: out}
  to: {block: bpskslicer, port: llr}
  route:
  - {x: 7, y: 11}
  - {x: 8, y: 11}
  - {x: 8, y: 10}
- name: net3
  from: {block: psksymbolmapper, port: out}
  to: {block: upsampler, port: x}
  route:
  - {x: 1, y: 1}
  - {x: 2, y: 1}
  - {x: 2, y: 0}
  - {x: 3, y: 0}
- name: net4
  from: {block: complexrrcmatchedfilter, port: yi}
  to: {block: complexcostasloop, port: xi}
  route:
  - {x: 2, y: 8}
  - {x: 1, y: 8}
  - {x: 0, y: 8}
  - {x: 0, y: 9}
  - {x: 0, y: 10}
  - {x: 0, y: 11}
- name: net5
  from: {block: rrcpulseshaper, port: out}
  to: {block: iqupconvert, port: xi}
  route:
  - {x: 6, y: 2}
  - {x: 5, y: 2}
  - {x: 4, y: 2}
  - {x: 3, y: 2}
  - {x: 2, y: 2}
  - {x: 1, y: 2}
  - {x: 1, y: 3}
  - {x: 1, y: 4}
- name: net6
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: complexrrcmatchedfilter, port: xi}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 0, y: 3}
  - {x: 0, y: 4}
  - {x: 0, y: 5}
  - {x: 0, y: 6}
  - {x: 0, y: 7}
  - {x: 1, y: 7}
  stream_id: rx
- name: net7
  from: {block: bpskslicer, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 8, y: 9}
  - {x: 8, y: 8}
  - {x: 8, y: 7}
  - {x: 8, y: 6}
  - {x: 8, y: 5}
  - {x: 8, y: 4}
  - {x: 8, y: 3}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 5
- name: net8
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: psksymbolmapper, port: sample}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  stream_id: tx
- name: net9
  from: {block: upsampler, port: out}
  to: {block: rrcpulseshaper, port: sample}
  route:
  - {x: 3, y: 1}
  - {x: 4, y: 1}
  - {x: 4, y: 0}
  - {x: 5, y: 0}
- name: net10
  from: {block: iqupconvert, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 3, y: 5}
  - {x: 3, y: 6}
  - {x: 4, y: 6}
  - {x: 5, y: 6}
  - {x: 5, y: 5}
  - {x: 5, y: 4}
  - {x: 5, y: 3}
  - {x: 6, y: 3}
  - {x: 7, y: 3}
  - {x: 8, y: 3}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 10
- name: net11
  from: {block: complexrrcmatchedfilter, port: yq}
  to: {block: complexcostasloop, port: xq}
  route:
  - {x: 2, y: 8}
  - {x: 1, y: 8}
  - {x: 0, y: 8}
  - {x: 0, y: 9}
  - {x: 0, y: 10}
  - {x: 0, y: 11}
