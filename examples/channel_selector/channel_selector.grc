options:
  parameters: {author: Lattrex, catch_exceptions: 'True', category: '[GRC Hier Blocks]', cmake_opt: '',
    comment: '', copyright: '', description: 'A COMPLEX CHANNEL SELECTOR on one placeKYT chip: a real
      multi-channel input is made complex, a FreqXlatingFIR mixes the 9 kHz channel to baseband through
      a 9-tap pre-filter, a firdes complex low-pass (gain 0.9, cutoff 1.2 kHz) selects the channel, a
      complex constant rotates it, and the imag rail egresses. Golden: the IDENTICAL stock-GNU-Radio chain
      (float_to_complex, freq_xlating_fir_filter_ccf, fir_filter_ccc(firdes.low_pass), multiply_const_cc,
      complex_to_imag) within a tolerance DERIVED from the per-block verified Q15 error bounds.', gen_cmake: 'On',
    gen_linking: dynamic, generate_options: qt_gui, hier_block_src_path: '.:', id: channel_selector, max_nouts: '0',
    output_language: python, placement: '(0,0)', qt_qss_theme: '', realtime_scheduling: '', run: 'True',
    run_command: '{python} -u {filename}', run_options: prompt, sizing_mode: fixed, thread_safe_setters: '',
    title: Complex channel selector (freq-xlating FIR front end), window_size: '(1600,1000)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: imports
  id: import
  parameters: {alias: '', comment: '', imports: import math}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 68]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters: {comment: RF-ish sample rate, value: '32000'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: sig
  id: variable
  parameters: {comment: 'two in-channel tones at 8.6/9.4 kHz + interferers at 4 and 14 kHz (sum <= 0.9
      FS: Q15 ingress headroom)', value: '[0.25*math.sin(2*math.pi*8600*t/32000) + 0.25*math.cos(2*math.pi*9400*t/32000)
      + 0.2*math.sin(2*math.pi*4000*t/32000) + 0.2*math.sin(2*math.pi*14000*t/32000) for t in range(320)]'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters: {comment: samples per burst, value: len(sig)}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [620, 12]
    rotation: 0
    state: enabled
- name: fxf_taps
  id: variable
  parameters: {comment: '9-tap hamming-windowed sinc, cutoff 4 kHz, normalized sum|t|=0.98 (FreqXlatingFIR
      requires sum|taps| <= 1)', value: '[0.0, 0.018715, 0.099838, 0.226239, 0.290416, 0.226239, 0.099838,
      0.018715, 0.0]'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 12]
    rotation: 0
    state: enabled
- name: rf_vec
  id: blocks_vector_source_x
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', repeat: 'False',
    tags: '[]', type: float, vector: sig, vlen: '1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 172]
    rotation: 0
    state: enabled
- name: rf_in
  id: kyttar_source
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', burst_len: burst_len,
    complex_in: float, device_id: '"kyttar_0"', num_channels: '1', pipelined: 'no', port_name: '"x16_in"',
    schedule: '"interleaved"', server_host: '"127.0.0.1"', server_port: '58950', stream_id: '"rf"'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 164]
    rotation: 0
    state: enabled
- name: qzero
  id: blocks_null_source
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', bus_structure_source: '[[0,],]',
    num_outputs: '1', type: float, vlen: '1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 260]
    rotation: 0
    state: enabled
- name: f2c
  id: kyttar_float_to_complex
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', device_id: '"kyttar_0"'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [380, 180]
    rotation: 0
    state: enabled
- name: fxf
  id: kyttar_freq_xlating_fir
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', device_id: '"kyttar_0"',
    decimation: '1', taps: fxf_taps, center_freq: '9000', sampling_freq: samp_rate, pipeline_lock: 'False'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 164]
    rotation: 0
    state: enabled
- name: clpf
  id: kyttar_complex_low_pass_filter
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', device_id: '"kyttar_0"',
    gain: '0.9', samp_rate: samp_rate, cutoff_freq: '1200', transition_width: '2500', window: '"hamming"',
    beta: '6.76'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 164]
    rotation: 0
    state: enabled
- name: rot
  id: kyttar_multiply_const_complex
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', device_id: '"kyttar_0"',
    re: '0.6', im: '0.35'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 180]
    rotation: 0
    state: enabled
- name: conj
  id: kyttar_conjugate
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 306]
    rotation: 0
    state: enabled
- name: c2i
  id: kyttar_complex_to_imag
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', device_id: '"kyttar_0"'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1150, 180]
    rotation: 0
    state: enabled
- name: rf_out
  id: kyttar_sink
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', device_id: '"kyttar_0"',
    hold_secs: '8.0', in_type: float, num_channels: '1', port_name: '"x16_out"', server_port: '58950',
    server_repeat: 'False', stream_id: '"rf"'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1280, 164]
    rotation: 0
    state: enabled
- name: scope
  id: qtgui_time_sink_x
  parameters: {affinity: '', alias: '', comment: '', ctrlpanel: 'False', entags: 'True', grid: 'False',
    gui_hint: '', legend: 'True', autoscale: 'False', axislabels: 'True', name: '"selected channel (baseband,
      rotated - imag rail)"', nconnections: '1', size: '256', srate: samp_rate, stemplot: 'False', tr_chan: '0',
    tr_delay: '0', tr_level: '0.0', tr_mode: qtgui.TRIG_MODE_FREE, tr_slope: qtgui.TRIG_SLOPE_POS, tr_tag: '""',
    type: float, update_time: '0.10', ylabel: level, ymax: '1', ymin: '-1', yunit: '""', alpha1: '1.0',
    color1: blue, label1: Signal 1, marker1: '-1', style1: '1', width1: '1', alpha2: '1.0', color2: red,
    label2: Signal 2, marker2: '-1', style2: '1', width2: '1', alpha3: '1.0', color3: green, label3: Signal
      3, marker3: '-1', style3: '1', width3: '1', alpha4: '1.0', color4: black, label4: Signal 4, marker4: '-1',
    style4: '1', width4: '1', alpha5: '1.0', color5: cyan, label5: Signal 5, marker5: '-1', style5: '1',
    width5: '1', alpha6: '1.0', color6: magenta, label6: Signal 6, marker6: '-1', style6: '1', width6: '1',
    alpha7: '1.0', color7: yellow, label7: Signal 7, marker7: '-1', style7: '1', width7: '1', alpha8: '1.0',
    color8: dark red, label8: Signal 8, marker8: '-1', style8: '1', width8: '1', alpha9: '1.0', color9: dark
      green, label9: Signal 9, marker9: '-1', style9: '1', width9: '1', alpha10: '1.0', color10: dark
      blue, label10: Signal 10, marker10: '-1', style10: '1', width10: '1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 140]
    rotation: 0
    state: enabled
connections:
- [rf_vec, '0', rf_in, '0']
- [rf_in, '0', f2c, '0']
- [qzero, '0', f2c, '1']
- [f2c, '0', fxf, '0']
- [fxf, '0', clpf, '0']
- [clpf, '0', rot, '0']
- [rot, '0', conj, '0']
- [conj, '0', c2i, '0']
- [c2i, '0', rf_out, '0']
- [rf_out, '0', scope, '0']
metadata: {file_format: 1, grc_version: 3.10.9.2}
