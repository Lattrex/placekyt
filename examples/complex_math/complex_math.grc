- name: sum_iq2c
  id: epy_block
  parameters:
    _source_code: "\"\"\"Interleaved I,Q floats -> complex pairs (2:1).\n\nThe kyttar\
      \ sink emits a complex chain's recovered stream as INTERLEAVED\nI,Q float32\
      \ (its output port is always float); this embedded block\nreassembles gr_complex\
      \ for the scope. An embedded block\n(not blocks.float_to_complex)\
      \ on purpose: stock converter ids are chip-side\nsplice markers to the placeKYT\
      \ importer, and this display glue must stay\nhost-side.\"\"\"\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\n\nclass blk(gr.decim_block):\n    def __init__(self):\n\
      \        gr.decim_block.__init__(self, name='IQ Pairs to Complex',\n       \
      \                         in_sig=[np.float32],\n                           \
      \     out_sig=[np.complex64], decim=2)\n\n    def work(self, input_items, output_items):\n\
      \        n = len(output_items[0])\n        x = input_items[0][:2 * n]\n    \
      \    output_items[0][:] = x[0::2] + 1j * x[1::2]\n        return n\n"
    affinity: ''
    alias: ''
    comment: interleaved I,Q floats -> gr_complex (host-side display glue)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('IQ Pairs to Complex', 'blk', [], [('0', 'float', 1)], [('0', 'complex',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [980, 172]
    rotation: 0
    state: enabled
- name: diff_iq2c
  id: epy_block
  parameters:
    _source_code: "\"\"\"Interleaved I,Q floats -> complex pairs (2:1).\n\nThe kyttar\
      \ sink emits a complex chain's recovered stream as INTERLEAVED\nI,Q float32\
      \ (its output port is always float); this embedded block\nreassembles gr_complex\
      \ for the scope. An embedded block\n(not blocks.float_to_complex)\
      \ on purpose: stock converter ids are chip-side\nsplice markers to the placeKYT\
      \ importer, and this display glue must stay\nhost-side.\"\"\"\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\n\nclass blk(gr.decim_block):\n    def __init__(self):\n\
      \        gr.decim_block.__init__(self, name='IQ Pairs to Complex',\n       \
      \                         in_sig=[np.float32],\n                           \
      \     out_sig=[np.complex64], decim=2)\n\n    def work(self, input_items, output_items):\n\
      \        n = len(output_items[0])\n        x = input_items[0][:2 * n]\n    \
      \    output_items[0][:] = x[0::2] + 1j * x[1::2]\n        return n\n"
    affinity: ''
    alias: ''
    comment: interleaved I,Q floats -> gr_complex (host-side display glue)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('IQ Pairs to Complex', 'blk', [], [('0', 'float', 1)], [('0', 'complex',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [980, 316]
    rotation: 0
    state: enabled
