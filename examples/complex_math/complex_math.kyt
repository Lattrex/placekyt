project:
  format_version: 1
  name: Complex math — AddCC / SubCC / MultiplyCC (two-tone mixer)
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: addcc
  type: AddCCBlock
  library: lattrex.official
  params:
    num_inputs: 2
  placement:
    chip: 0
    cells:
    - {cell_id: rail_i, x: 1, y: 1, face: east}
    - {cell_id: rail_q, x: 2, y: 1, face: east}
- name: subcc
  type: SubCCBlock
  library: lattrex.official
  params:
    num_inputs: 2
  placement:
    chip: 0
    cells:
    - {cell_id: rail_i, x: 4, y: 1, face: east}
    - {cell_id: rail_q, x: 5, y: 1, face: east}
- name: multiplycc
  type: MultiplyCCBlock
  library: lattrex.official
  params:
    num_inputs: 2
  placement:
    chip: 0
    cells:
    - {cell_id: prods, x: 7, y: 1, face: east}
    - {cell_id: combine, x: 8, y: 1, face: east}
connections:
- name: net1
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: addcc, port: ai}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  stream_id: sum
  src_complex: true
- name: net2
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: subcc, port: ai}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 1, y: 2}
  - {x: 2, y: 2}
  - {x: 3, y: 2}
  - {x: 4, y: 2}
  stream_id: diff
  src_complex: true
- name: net3
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: multiplycc, port: ai}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 1, y: 2}
  - {x: 2, y: 2}
  - {x: 3, y: 2}
  - {x: 4, y: 2}
  - {x: 5, y: 2}
  - {x: 6, y: 2}
  - {x: 6, y: 1}
  - {x: 7, y: 1}
  stream_id: prod
  src_complex: true
- name: net4
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: addcc, port: bi}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  stream_id: b_add
  src_complex: true
- name: net5
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: subcc, port: bi}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 1, y: 2}
  - {x: 2, y: 2}
  - {x: 3, y: 2}
  - {x: 4, y: 2}
  stream_id: b_sub
  src_complex: true
- name: net6
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: multiplycc, port: bi}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 1, y: 2}
  - {x: 2, y: 2}
  - {x: 3, y: 2}
  - {x: 4, y: 2}
  - {x: 5, y: 2}
  - {x: 6, y: 2}
  - {x: 6, y: 1}
  - {x: 7, y: 1}
  stream_id: b_mul
  src_complex: true
- name: net7
  from: {block: addcc, port: yi}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 2, y: 1}
  - {x: 3, y: 1}
  - {x: 3, y: 0}
  - {x: 4, y: 0}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 13
- name: net8
  from: {block: subcc, port: yi}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 5, y: 1}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 21
- name: net9
  from: {block: multiplycc, port: yi}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 8, y: 1}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 19
- name: net10
  from: {block: addcc, port: yq}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 2, y: 1}
  - {x: 3, y: 1}
  - {x: 3, y: 0}
  - {x: 4, y: 0}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 14
- name: net11
  from: {block: subcc, port: yq}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 5, y: 1}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 22
- name: net12
  from: {block: multiplycc, port: yq}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 8, y: 1}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 20
