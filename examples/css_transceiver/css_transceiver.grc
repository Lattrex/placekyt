- name: rx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: recovered bin indices <- chip x16_out (stream 'rx'). server_repeat loops the genuine one-batch result
      so the scopes keep painting (GNU Radio strands the tail of a finite stream).
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'True'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1540
    - 196
    rotation: 0
    state: enabled
