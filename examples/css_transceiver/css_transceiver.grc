  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    comment: the received chirp burst (I and Q). Each 16-sample frame is one cyclic-shifted up-chirp; the shift
      IS the symbol.
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    legend: 'True'
    name: '"RF burst — CSS up-chirps (A: +10 dB, B: -10 dB)"'
