  id: kyttar_conj_chirp_mixer
  parameters:
    affinity: ''
    alias: ''
    comment: DECHIRP — multiply by the conjugate reference up-chirp; a symbol chirp becomes a constant tone (placed on chip)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: n_css
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 188
    rotation: 0
    state: enabled
- name: fft
  id: kyttar_fft16
  parameters:
    affinity: ''
    alias: ''
    comment: 16-point streaming FFT — the tone lands in ONE bin (placed on chip; output order is bit-reversed)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 188
    rotation: 0
