- name: verdict
  id: variable_qtgui_label
  parameters:
    comment: 'the plot''s own caption: both panels below are the expected result.'
    formatter: None
    gui_hint: 0,0,1,2
    label: 'BOTH PANELS ARE THE EXPECTED RESULT. Panel A (+10 dB) locks, SER 0.00. Panel B (-10 dB) collapses, SER ~0.63 -
      B is a deliberate NEGATIVE CONTROL: same placed chip, same burst, 20 dB worse signal. Its failure is what makes A''s
      SER 0 mean something.'
    type: string
    value: '''A LOCKS + B COLLAPSES = WORKING AS DESIGNED'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1180
    - 12
    rotation: 0
    state: enabled
