options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'CSS (chirp spread spectrum) receiver on one placeKYT array. The WHOLE receive spine is placed
      on the chip: dechirp (conjugate chirp mixer) -> 16-point streaming FFT -> bin power -> the alignment Delay(1)
      -> framewise argmax. One continuous burst carries the message ''KYTTAR CSS'' twice: segment A at +10 dB SNR
      decodes exactly, segment B at -10 dB is the on-chip negative control and collapses. The decode map is s =
      brev4(bin index) because FFT16 emits bins in bit-reversed order. The transmitter and channel are host-side
      numpy (bit-exact to the TX blocks'' own chip-verified goldens) - this is an RX example and does not claim
      a transmitter on the chip.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: css_transceiver
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    realtime_scheduling: ''
    sizing_mode: fixed
    thread_safe_setters: ''
    title: CSS receiver - chirp spread spectrum on one placeKYT array
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: import_stim
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: from gnuradio.kyttar import css_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 68
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: display sample rate (scope axis only)
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: n_css
  id: variable
  parameters:
    comment: samples per chirp symbol == FFT size == alphabet
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 12
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: complex samples in the whole shipped burst (both segments)
    value: stim.burst_len()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 12
    rotation: 0
    state: enabled
- name: n_words
  id: variable
  parameters:
    comment: index words the chip emits (the spine is n:1)
    value: stim.n_out_words()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 12
    rotation: 0
    state: enabled
- name: tx_syms
  id: variable
  parameters:
    comment: the transmitted symbols of ONE segment (preamble + message) - the reference the display block locks
      to the decoded stream
    value: stim.framed_symbols()[:stim.n_data_symbols()]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 12
    rotation: 0
    state: enabled
- name: rx_iq
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'the CSS burst as the radio sees it: the framed message as cyclic-shifted up-chirps, segment A at +10
      dB SNR then segment B at -10 dB (the on-chip negative control). Repeating, so the scopes keep painting.'
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: complex
    vector: stim.rx_burst()
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 32
    - 220
    rotation: 0
    state: enabled
