options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'CSS (chirp spread spectrum) receiver on one placeKYT array. The WHOLE receive spine is placed on the chip:
      dechirp (conjugate chirp mixer) -> 16-point streaming FFT -> bin power -> the alignment Delay(1) -> framewise argmax.
      One continuous burst carries the message ''KYTTAR CSS'' twice: segment A at +10 dB SNR decodes exactly, segment B at
      -10 dB is the on-chip negative control and collapses. The decode map is s = brev4(bin index) because FFT16 emits bins
      in bit-reversed order. The transmitter and channel are host-side numpy (bit-exact to the TX blocks'' own chip-verified
      goldens) - this is an RX example and does not claim a transmitter on the chip.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: css_transceiver
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    realtime_scheduling: ''
    sizing_mode: fixed
    thread_safe_setters: ''
    title: CSS receiver - chirp spread spectrum on one placeKYT array
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: import_stim
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: from gnuradio.kyttar import css_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 68
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: display sample rate (scope axis only)
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: n_css
  id: variable
  parameters:
    comment: samples per chirp symbol == FFT size == alphabet
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 12
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: complex samples in the whole shipped burst (both segments)
    value: stim.burst_len()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 12
    rotation: 0
    state: enabled
- name: n_words
  id: variable
  parameters:
    comment: index words the chip emits (the spine is n:1)
    value: stim.n_out_words()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 12
    rotation: 0
    state: enabled
- name: tx_syms
  id: variable
  parameters:
    comment: the transmitted symbols of ONE segment (preamble + message) - the reference the display block locks to the decoded
      stream
    value: stim.framed_symbols()[:stim.n_data_symbols()]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 12
    rotation: 0
    state: enabled
- name: rx_iq
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'the CSS burst as the radio sees it: the framed message as cyclic-shifted up-chirps, segment A at +10 dB SNR
      then segment B at -10 dB (the on-chip negative control). Repeating, so the scopes keep painting.'
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: complex
    vector: stim.rx_burst()
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 32
    - 220
    rotation: 0
    state: enabled
- name: input_scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    comment: the received chirp burst (I and Q). Each 16-sample frame is one cyclic-shifted up-chirp; the shift IS the symbol.
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: 4,0,1,1
    legend: 'True'
    name: '"RF burst — CSS up-chirps (A: +10 dB, B: -10 dB)"'
    nconnections: '1'
    size: burst_len // 2
    srate: samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    ylabel: level
    ymax: '1'
    ymin: '-1'
    yunit: '""'
    alpha1: '1.0'
    color1: blue
    label1: Signal 1
    marker1: '-1'
    style1: '1'
    alpha2: '1.0'
    color2: red
    label2: Signal 2
    marker2: '-1'
    style2: '1'
    alpha3: '1.0'
    color3: green
    label3: Signal 3
    marker3: '-1'
    style3: '1'
    alpha4: '1.0'
    color4: black
    label4: Signal 4
    marker4: '-1'
    style4: '1'
    alpha5: '1.0'
    color5: cyan
    label5: Signal 5
    marker5: '-1'
    style5: '1'
    alpha6: '1.0'
    color6: magenta
    label6: Signal 6
    marker6: '-1'
    style6: '1'
    alpha7: '1.0'
    color7: yellow
    label7: Signal 7
    marker7: '-1'
    style7: '1'
    alpha8: '1.0'
    color8: dark red
    label8: Signal 8
    marker8: '-1'
    style8: '1'
    alpha9: '1.0'
    color9: dark green
    label9: Signal 9
    marker9: '-1'
    style9: '1'
    alpha10: '1.0'
    color10: dark blue
    label10: Signal 10
    marker10: '-1'
    style10: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 32
    - 430
    rotation: 0
    state: enabled
- name: rx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: the burst -> chip x16_in (stream 'rx'). complex_in=complex, so the recovered stream comes back as RAW word floats
      — the argmax index plots directly, no q15 rescale.
