- name: magsq
  id: kyttar_complex_to_mag_squared
  parameters:
    affinity: ''
    alias: ''
    comment: bin POWER (placed on chip)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 196
    rotation: 0
    state: enabled
- name: align
  id: kyttar_delay
  parameters:
    affinity: ''
    alias: ''
    comment: THE ALIGNMENT DELAY — FFT16's latency is 15 == -1 (mod 16), so argmax frames would STRADDLE two FFT frames. This
      ONE sample lands every frame on exactly one FFT frame. Remove it and the decode breaks (placed on chip).
    delay: '1'
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1040
    - 196
    rotation: 0
    state: enabled
- name: argmax
  id: kyttar_bin_argmax
  parameters:
    affinity: ''
    alias: ''
    comment: the winning bin of each 16-bin frame — the detected symbol (placed on chip)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: n_css
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1200
    - 196
    rotation: 0
    state: enabled
