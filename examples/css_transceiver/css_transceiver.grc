    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 196
    rotation: 0
    state: enabled
