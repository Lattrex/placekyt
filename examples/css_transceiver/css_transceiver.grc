options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'CSS (chirp spread spectrum) receiver on one placeKYT array. The WHOLE receive spine
      is placed on the chip: dechirp (conjugate chirp mixer) -> 16-point streaming FFT -> bin power ->
      the alignment Delay(1) -> framewise argmax. One continuous burst carries the message ''KYTTAR CSS''
      twice: segment A at +10 dB SNR decodes exactly, segment B at -10 dB is the on-chip negative control
      and collapses. The decode map is s = brev4(bin index) because FFT16 emits bins in bit-reversed order.
      The transmitter and channel are host-side numpy (bit-exact to the TX blocks'' own chip-verified
      goldens) - this is an RX example and does not claim a transmitter on the chip.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: css_transceiver
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    realtime_scheduling: ''
    sizing_mode: fixed
    thread_safe_setters: ''
    title: CSS receiver - chirp spread spectrum on one placeKYT array
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: import_stim
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: from gnuradio.kyttar import css_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 68
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: display sample rate (scope axis only)
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: n_css
  id: variable
  parameters:
    comment: samples per chirp symbol == FFT size == alphabet
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 12
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: complex samples in the whole shipped burst (both segments)
    value: stim.burst_len()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 12
    rotation: 0
    state: enabled
- name: n_words
  id: variable
  parameters:
    comment: index words the chip emits (the spine is n:1)
    value: stim.n_out_words()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 12
    rotation: 0
    state: enabled
- name: tx_syms
  id: variable
  parameters:
    comment: the transmitted symbol sequence, repeated for both segments (the red reference trace)
    value: stim.display_symbols()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 12
    rotation: 0
    state: enabled
- name: rx_iq
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'the CSS burst as the radio sees it: the framed message as cyclic-shifted up-chirps, segment
      A at +10 dB SNR then segment B at -10 dB (the on-chip negative control). Repeating, so the scopes
      keep painting.'
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: complex
    vector: stim.rx_burst()
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 32
    - 220
    rotation: 0
    state: enabled
- name: input_scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    comment: the received chirp burst (I and Q). Each 16-sample frame is one cyclic-shifted up-chirp;
      the shift IS the symbol.
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    legend: 'True'
    name: "\"RF burst \u2014 CSS up-chirps (A: +10 dB, B: -10 dB)\""
    nconnections: '1'
    size: burst_len // 2
    srate: samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    ylabel: level
    ymax: '1'
    ymin: '-1'
    yunit: '""'
    alpha1: '1.0'
    color1: blue
    label1: Signal 1
    marker1: '-1'
    style1: '1'
    alpha2: '1.0'
    color2: red
    label2: Signal 2
    marker2: '-1'
    style2: '1'
    alpha3: '1.0'
    color3: green
    label3: Signal 3
    marker3: '-1'
    style3: '1'
    alpha4: '1.0'
    color4: black
    label4: Signal 4
    marker4: '-1'
    style4: '1'
    alpha5: '1.0'
    color5: cyan
    label5: Signal 5
    marker5: '-1'
    style5: '1'
    alpha6: '1.0'
    color6: magenta
    label6: Signal 6
    marker6: '-1'
    style6: '1'
    alpha7: '1.0'
    color7: yellow
    label7: Signal 7
    marker7: '-1'
    style7: '1'
    alpha8: '1.0'
    color8: dark red
    label8: Signal 8
    marker8: '-1'
    style8: '1'
    alpha9: '1.0'
    color9: dark green
    label9: Signal 9
    marker9: '-1'
    style9: '1'
    alpha10: '1.0'
    color10: dark blue
    label10: Signal 10
    marker10: '-1'
    style10: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 32
    - 430
    rotation: 0
    state: enabled
- name: rx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: "the burst -> chip x16_in (stream 'rx'). complex_in=complex, so the recovered stream comes\
      \ back as RAW word floats \u2014 the argmax index plots directly, no q15 rescale."
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 196
    rotation: 0
    state: enabled
- name: dechirp
  id: kyttar_conj_chirp_mixer
  parameters:
    affinity: ''
    alias: ''
    comment: "DECHIRP \u2014 multiply by the conjugate reference up-chirp; a symbol chirp becomes a constant\
      \ tone (placed on chip)"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: n_css
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 188
    rotation: 0
    state: enabled
- name: fft
  id: kyttar_fft16
  parameters:
    affinity: ''
    alias: ''
    comment: "16-point streaming FFT \u2014 the tone lands in ONE bin (placed on chip; output order is\
      \ bit-reversed)"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 188
    rotation: 0
    state: enabled
- name: magsq
  id: kyttar_complex_to_mag_squared
  parameters:
    affinity: ''
    alias: ''
    comment: bin POWER (placed on chip)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 196
    rotation: 0
    state: enabled
- name: align
  id: kyttar_delay
  parameters:
    affinity: ''
    alias: ''
    comment: "THE ALIGNMENT DELAY \u2014 FFT16's latency is 15 == -1 (mod 16), so argmax frames would\
      \ STRADDLE two FFT frames. This ONE sample lands every frame on exactly one FFT frame. Remove it\
      \ and the decode breaks (placed on chip)."
    delay: '1'
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1040
    - 196
    rotation: 0
    state: enabled
- name: argmax
  id: kyttar_bin_argmax
  parameters:
    affinity: ''
    alias: ''
    comment: "the winning bin of each 16-bin frame \u2014 the detected symbol (placed on chip)"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: n_css
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1200
    - 196
    rotation: 0
    state: enabled
- name: idx_s2f
  id: blocks_short_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    scale: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1380
    - 220
    rotation: 0
    state: enabled
- name: rx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: recovered bin indices <- chip x16_out (stream 'rx'). server_repeat loops the genuine one-batch
      result so the scopes keep painting (GNU Radio strands the tail of a finite stream).
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'True'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1540
    - 196
    rotation: 0
    state: enabled
- name: bin_scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    comment: the RAW argmax index straight off the chip. Bins come out in FFT16's bit-reversed order,
      so this is not yet the symbol.
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    legend: 'True'
    name: "\"Chip output \u2014 winning FFT bin (raw index 0..15)\""
    nconnections: '1'
    size: n_words
    srate: samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    ylabel: bin index
    ymax: '16'
    ymin: '-1'
    yunit: '""'
    alpha1: '1.0'
    color1: green
    label1: Signal 1
    marker1: '-1'
    style1: '1'
    alpha2: '1.0'
    color2: red
    label2: Signal 2
    marker2: '-1'
    style2: '1'
    alpha3: '1.0'
    color3: green
    label3: Signal 3
    marker3: '-1'
    style3: '1'
    alpha4: '1.0'
    color4: black
    label4: Signal 4
    marker4: '-1'
    style4: '1'
    alpha5: '1.0'
    color5: cyan
    label5: Signal 5
    marker5: '-1'
    style5: '1'
    alpha6: '1.0'
    color6: magenta
    label6: Signal 6
    marker6: '-1'
    style6: '1'
    alpha7: '1.0'
    color7: yellow
    label7: Signal 7
    marker7: '-1'
    style7: '1'
    alpha8: '1.0'
    color8: dark red
    label8: Signal 8
    marker8: '-1'
    style8: '1'
    alpha9: '1.0'
    color9: dark green
    label9: Signal 9
    marker9: '-1'
    style9: '1'
    alpha10: '1.0'
    color10: dark blue
    label10: Signal 10
    marker10: '-1'
    style10: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1760
    - 140
    rotation: 0
    state: enabled
- name: bin_to_sym
  id: epy_block
  parameters:
    _source_code: "# SPDX-License-Identifier: GPL-3.0-or-later\n\"\"\"CSS DEMOD MAP \u2014 turn the chip's\
      \ raw argmax BIN INDEX into the SYMBOL.\n\nThe on-chip FFT16 emits its 16 bins in bit-reversed (DIF)\
      \ order, so the\nwinning bin index i is not the symbol: the symbol is ``s = brev4(i)`` \u2014 the\n\
      4-bit reversal of the index. This block applies exactly that map, and nothing\nelse, to the raw\
      \ index words the kyttar sink delivers.\n\nAn embedded block on purpose: this is host-side DISPLAY\
      \ glue (the same map\nthe example's gate applies), not chip DSP \u2014 stock converter ids are chip-side\n\
      splice markers to the placeKYT importer, so a plain converter cannot be used\nhere.\n\nin0  = the\
      \ kyttar sink output. A complex-input chain egresses RAW word floats,\n       so each item is already\
      \ the integer index 0..15 (no q15 rescale).\nout0 = the decoded symbol s = brev4(index), as a float\
      \ 0..15 \u2014 plot it\n       against the transmitted symbol sequence.\n\"\"\"\nimport numpy as\
      \ np\nfrom gnuradio import gr\n\n# brev4: 4-bit reversal, the FFT16 DIF output-order map (index\
      \ -> symbol).\n_BREV4 = [((i & 1) << 3) | ((i & 2) << 1) | ((i & 4) >> 1) | ((i & 8) >> 3)\n   \
      \       for i in range(16)]\n\n\nclass blk(gr.sync_block):\n    def __init__(self, n=16):\n    \
      \    gr.sync_block.__init__(self, name='CSS Bin -> Symbol (brev4)',\n                          \
      \     in_sig=[np.float32], out_sig=[np.float32])\n        self.n = int(n)\n\n    def work(self,\
      \ input_items, output_items):\n        x = input_items[0]\n        idx = np.rint(x.astype(np.float64)).astype(np.int64)\
      \ & 0xFFFF\n        out = np.zeros(len(idx), dtype=np.float32)\n        for k, i in enumerate(idx):\n\
      \            out[k] = float(_BREV4[i]) if 0 <= i < 16 else -1.0\n        output_items[0][:len(out)]\
      \ = out\n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: "s = brev4(index) \u2014 FFT16 emits bins bit-reversed, so the index must be 4-bit-reversed\
      \ to become the symbol"
    maxoutbuf: '0'
    minoutbuf: '0'
    n: n_css
    _io_cache: ('CSS Bin -> Symbol (brev4)', 'blk', [('n', 'int', 16)], [('0', 'float', 1)], [('0', 'float',
      1)], '', ['n'])
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1760
    - 320
    rotation: 0
    state: enabled
- name: tx_ref
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: "the TRANSMITTED symbol sequence (host reference) \u2014 the red trace the chip's decoded\
      \ symbols must sit on top of in segment A, and visibly miss in segment B"
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: float
    vector: tx_syms
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1760
    - 470
    rotation: 0
    state: enabled
- name: sym_scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    comment: blue = the chip's decoded symbol s = brev4(bin); red = what was transmitted. Segment A (+10
      dB) matches exactly; segment B (-10 dB) is the on-chip negative control and does not.
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    legend: 'True'
    name: "\"DECODED SYMBOL vs TRANSMITTED \u2014 A locks, B collapses\""
    nconnections: '2'
    size: n_words
    srate: samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    ylabel: symbol
    ymax: '16'
    ymin: '-1'
    yunit: '""'
    alpha1: '1.0'
    color1: blue
    label1: decoded symbol (chip)
    marker1: '0'
    style1: '0'
    alpha2: '1.0'
    color2: red
    label2: transmitted symbol
    marker2: '1'
    style2: '0'
    alpha3: '1.0'
    color3: green
    label3: Signal 3
    marker3: '-1'
    style3: '1'
    alpha4: '1.0'
    color4: black
    label4: Signal 4
    marker4: '-1'
    style4: '1'
    alpha5: '1.0'
    color5: cyan
    label5: Signal 5
    marker5: '-1'
    style5: '1'
    alpha6: '1.0'
    color6: magenta
    label6: Signal 6
    marker6: '-1'
    style6: '1'
    alpha7: '1.0'
    color7: yellow
    label7: Signal 7
    marker7: '-1'
    style7: '1'
    alpha8: '1.0'
    color8: dark red
    label8: Signal 8
    marker8: '-1'
    style8: '1'
    alpha9: '1.0'
    color9: dark green
    label9: Signal 9
    marker9: '-1'
    style9: '1'
    alpha10: '1.0'
    color10: dark blue
    label10: Signal 10
    marker10: '-1'
    style10: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2000
    - 380
    rotation: 0
    state: enabled
