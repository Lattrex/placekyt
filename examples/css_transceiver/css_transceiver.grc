- name: rx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: the burst -> chip x16_in (stream 'rx'). complex_in=complex, so the recovered stream comes back as RAW
      word floats — the argmax index plots directly, no q15 rescale.
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 196
    rotation: 0
    state: enabled
- name: dechirp
  id: kyttar_conj_chirp_mixer
  parameters:
    affinity: ''
    alias: ''
    comment: DECHIRP — multiply by the conjugate reference up-chirp; a symbol chirp becomes a constant tone (placed
      on chip)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: n_css
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 188
    rotation: 0
    state: enabled
- name: fft
  id: kyttar_fft16
  parameters:
    affinity: ''
    alias: ''
    comment: 16-point streaming FFT — the tone lands in ONE bin (placed on chip; output order is bit-reversed)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 188
    rotation: 0
    state: enabled
- name: magsq
  id: kyttar_complex_to_mag_squared
  parameters:
    affinity: ''
    alias: ''
    comment: bin POWER (placed on chip)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 196
    rotation: 0
    state: enabled
- name: align
  id: kyttar_delay
  parameters:
    affinity: ''
    alias: ''
    comment: THE ALIGNMENT DELAY — FFT16's latency is 15 == -1 (mod 16), so argmax frames would STRADDLE two FFT
      frames. This ONE sample lands every frame on exactly one FFT frame. Remove it and the decode breaks (placed
      on chip).
    delay: '1'
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1040
    - 196
    rotation: 0
    state: enabled
- name: argmax
  id: kyttar_bin_argmax
  parameters:
    affinity: ''
    alias: ''
    comment: the winning bin of each 16-bin frame — the detected symbol (placed on chip)
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: n_css
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1200
    - 196
    rotation: 0
    state: enabled
