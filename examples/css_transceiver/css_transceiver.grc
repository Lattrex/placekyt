- name: ser_readout
  id: qtgui_number_sink
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    avg: '0'
    comment: the two headline numbers, MEASURED live on the plotted symbols of this very run. A must read 0.00; B must NOT
      - B is the negative control and a low number there would mean the control stopped working.
    graph_type: qtgui.NUM_GRAPH_HORIZ
    gui_hint: 3,0,1,2
    label1: SER  A (+10 dB, panel 1)  — reads 0.00, EXPECTED ✓
    label2: SER  B (−10 dB, panel 2, NEGATIVE CONTROL)  — reads HIGH, EXPECTED ✓
    max: '1'
    min: '0'
    name: '''MEASURED SYMBOL ERROR RATE — A must be 0.00, B must NOT (both are the expected result)'''
    nconnections: '2'
    type: float
    unit1: '''SER'''
    unit2: '''SER'''
    update_time: '0.10'
    color1: ("blue", "red")
    color2: ("black", "red")
    factor1: '1'
    factor2: '1'
    label3: ''
    unit3: ''
    color3: ("black", "black")
    factor3: '1'
    label4: ''
