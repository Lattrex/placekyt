  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    wpm: '20'
    samples_per_dot: unit
    edge_samples: '2'
    charset: None
    panel_hop: '1'
    emit_hop: '1'
    emit_dest: '0'
    emit_entry: '1'
    done_entry: '0'
    read_wr_desc: '0'
    read_jp_desc: '0'
  states:
