options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'A FULL CW (Morse) TRANSCEIVER on one placeKYT chip: TX (chars ->
      SRAM-backed keyer -> ITU-R keyed envelope) and RX (keyed audio -> Abs envelope
      detector -> STREAMING fixed-unit SRAM-backed Morse decoder -> chars) duplexed
      by stream tags, the keyer ROM and the reverse-Morse LUT (at addr_base 12288)
      SHARING the single SRAM panel. The decoder is a skimmer locked to the keyer''s
      configured unit (samples_per_dot == unit_samples). Word gaps decode as character
      boundaries (no spaces - documented v1 cell-budget limit); terminate an RX burst
      with an EOT blip. PER-SAMPLE PACED (the panel contract).'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: cw_transceiver
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: CW full transceiver (duplex, shared SRAM panel)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: scope display rate (samples/s of the keyed envelope)
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 104
    - 12
    rotation: 0
    state: enabled
- name: imports
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 68
    rotation: 0
    state: enabled
- name: unit
  id: variable
  parameters:
    comment: dot length in samples (keyer samples_per_dot == decoder unit_samples)
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: msg
  id: variable
  parameters:
    comment: TX chars (space -> 0, the keyer's word-gap code)
    value: '[ord(c) if c != '' '' else 0 for c in ''CQ CQ DE KYTTAR'']'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 420
    - 12
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: ''
    value: len(msg)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 860
    - 12
    rotation: 0
    state: enabled
- name: rx_sig
  id: variable
  parameters:
    comment: keyed CW envelope for 'RST 599 73' (rect, unit samples/dot, 1-unit element
      gaps, 3-unit letter gaps) + tail silence + the EOT blip (>=2*unit silence then
      >=1 ON sample) that flushes the last letter. Replace with a live keyed-audio
      feed.
    value: sum([sum([[1.0]*(unit if e=='.' else 3*unit)+[0.0]*unit for e in m],[])+[0.0]*2*unit
      for m in ['.-.','...','-','.....','----.','----.','--...','...--']],[]) + [0.0]*3*unit
      + [0.9]*2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 12
    rotation: 0
    state: enabled
- name: rx_burst_len
  id: variable
  parameters:
    comment: ''
    value: len(rx_sig)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 12
    rotation: 0
    state: enabled
- name: msg_src
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: byte
    vector: msg
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 40
    - 150
    rotation: 0
    state: enabled
- name: b2f_in
  id: blocks_uchar_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
