- name: tx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'False'
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 860
    - 140
    rotation: 0
    state: enabled
- name: tx_scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    legend: 'True'
    autoscale: 'False'
    axislabels: 'True'
    name: '"TX keyed envelope (ITU-R Morse)"'
    nconnections: '1'
    size: '256'
    srate: samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    ylabel: level
    ymax: '1'
    ymin: '-1'
    yunit: '""'
    alpha1: '1.0'
    color1: blue
    label1: Signal 1
    marker1: '-1'
    style1: '1'
    width1: '1'
    alpha2: '1.0'
    color2: red
    label2: Signal 2
    marker2: '-1'
