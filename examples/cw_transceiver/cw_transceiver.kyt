panel_connections:
- panel: {id: 0, port: x1_in}
  chip: {id: 0, port: x1_out}
- panel: {id: 0, port: x1_out}
  chip: {id: 0, port: x1_in}
blocks:
- name: cwkeyer
  type: CWKeyerBlock
  library: lattrex.official
  params:
    wpm: 20
    samples_per_dot: 8
    edge_samples: 2
    charset:
    panel_hop: 2
    emit_hop: 13
    emit_dest: 5
    emit_entry: 17
    done_entry: 25
    read_wr_desc: 25224
    read_jp_desc: 29325
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 11, face: east}
    - {cell_id: 1, x: 0, y: 1, face: east}
- name: abs
  type: AbsBlock
  library: lattrex.official
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 7, y: 7, face: west}
- name: cwdecoder
  type: CWDecoderBlock
  library: lattrex.official
  params:
    threshold: 0.3
    panel_hop: 2
    emit_hop: 15
    emit_dest: 25
    emit_entry: 1
    unit_samples: 8
    read_addr_hop: 1
    read_dest: 7
    read_entry: 18
    read_wr_desc: 25505
    read_jp_desc: 29625
    out_dest: 5
    emit_jump_entry: 9
    run_dest: 5
    run_entry: 6
    addr_base: 16384
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 9, y: 8, face: south}
    - {cell_id: 1, x: 9, y: 9, face: south}
    - {cell_id: 2, x: 1, y: 10, face: north}
    - {cell_id: 3, x: 9, y: 10, face: south}
- name: cwkeyer_xover
  type: CrossoverBlock
  library: lattrex.official
  params:
    face_a: south
    hop_a: 5
    dest_a: 7
    entry_a: 11
    face_b: east
    hop_b: 8
    dest_b: 10
    entry_b: 0
    face_c: south
    hop_c: 5
    entry_c: 14
    restore_face: south
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 6, face: south}
- name: cwdecoder_colxo
  type: CrossoverBlock
  library: lattrex.official
  params:
    face_a: east
    hop_a: 4
    dest_a: 5
    entry_a: 0
    face_b: south
    hop_b: 1
    dest_b: 0
    entry_b: 0
    face_c: south
    hop_c: 1
    entry_c: 0
    restore_face: south
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 2, face: south}
connections:
- name: net3
  from: {block: abs, port: out}
  to: {block: cwdecoder, port: sample}
  route:
  - {x: 7, y: 7}
  - {x: 7, y: 8}
  - {x: 8, y: 8}
- name: cwkeyer_panel_return
  from: {chip_port: {chip: 0, port: x1_in}}
