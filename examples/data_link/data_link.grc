options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'A scrambled DATA-LINK LOOPBACK entirely on the placeKYT chip: payload
      bytes -> unpack to bits (MSB first) -> bitwise NOT -> AND 0x01 (extract the
      complemented bit) -> map_bb [1,0] (re-invert) -> additive LFSR scrambler (CCSDS-style
      mask 0x8A, seed 0x7F, len 7) -> differential encode (mod 2) -> differential
      decode -> the SAME additive scrambler again (self-inverse in sync = descrambler)
      -> char/float converter pair -> pack 8 bits -> the original bytes emerge at
      x16_out. Every stage is a placed Kyttar block; the golden is the IDENTICAL stock-GNU-Radio
      flowgraph, so the gate proves the whole placed composition is GR-equivalent,
      and the loopback identity (bytes out == bytes in) is asserted on top. The uchar/float
      casts at the chip ports are GRC type glue only (spliced on import).'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: data_link
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Scrambled data link (unpack -> NOT/AND/map -> LFSR -> diff -> loopback)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: message
  id: variable
  parameters:
    comment: the transported payload bytes
    value: '"KYTTAR DATA LINK 73"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: payload length in bytes
