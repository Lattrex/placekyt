options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'FEC protocol link on ONE placeKYT array, three streams on the shared duplex
      ports: ''tx'' = message bytes -> UnpackKBits(8) -> Hamming(7,4) encoder -> 4x3 block
      interleaver (the interleaved coded bits egress); ''txcrc'' = the same bytes -> on-chip
      CRC-16/CCITT-FALSE over the 12-byte frame; ''rx'' = the burst-corrupted channel bits
      -> deinterleaver -> Hamming syndrome decoder -> PackKBits(8) (the recovered bytes egress).
      The demo story: a 2-bit channel burst that would be UNCORRECTABLE inside one Hamming
      codeword is dispersed by the interleaver into two codewords (one correctable error each);
      the CRC Frame Verdict panel shows the chip-computed TX CRC equal to the CRC recomputed
      over the recovered bytes.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fec_link
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FEC protocol link (interleaver + Hamming + CRC on one array)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: display sample rate (scope axis only)
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: tx_len
  id: variable
  parameters:
    comment: TX chip-input bytes (message + flush pads)
    value: stim.n_tx_bytes()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 320
    - 12
    rotation: 0
    state: enabled
- name: chan_len
  id: variable
  parameters:
    comment: channel bits (alignment prefix + TX bits)
    value: stim.n_channel_bits()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 12
    rotation: 0
    state: enabled
- name: import_stim
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: from gnuradio.kyttar import fec_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 580
    - 12
    rotation: 0
    state: enabled
- name: msg_src
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: message + flush pads; finite, no repeat
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: byte
    vector: stim.tx_bytes()
    vlen: '1'
  states:
