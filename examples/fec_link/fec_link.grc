- name: tx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: tx_len
    comment: 'message bytes -> chip x16_in (stream ''tx''); per-sample paced for import-path
      robustness: on a wandering auto-P&R corridor the 1:14 rate-EXPANDING coded chain deadlocks
      saturated (the shipped shortest-path .kyt IS saturated-proven in the gate)'
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 148
    rotation: 0
    state: enabled
- name: crc_src
