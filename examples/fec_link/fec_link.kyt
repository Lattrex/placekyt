project:
  format_version: 1
  name: FEC protocol link (interleaver + Hamming + CRC on one array)
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: unpackkbits
  type: UnpackKBitsBlock
  library: lattrex.official
  params:
    k: 8
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 1, y: 1, face: east}
- name: hammingencoder
  type: HammingEncoderBlock
  library: lattrex.official
  placement:
    chip: 0
    cells:
    - {cell_id: pack, x: 3, y: 1, face: east}
    - {cell_id: expand, x: 4, y: 1, face: east}
- name: blockinterleaver
  type: BlockInterleaverBlock
  library: lattrex.official
  params:
    rows: 4
    cols: 3
    deinterleave: false
  placement:
    chip: 0
    cells:
    - {cell_id: rgen, x: 6, y: 1, face: south}
    - {cell_id: wctl, x: 6, y: 2, face: south}
    - {cell_id: store, x: 6, y: 3, face: west}
- name: crc16
  type: Crc16Block
  library: lattrex.official
  params:
    poly: 4129
    init: 65535
    frame_len: 12
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 1, y: 3, face: east}
- name: blockinterleaver_2
  type: BlockInterleaverBlock
  library: lattrex.official
  params:
    rows: 4
    cols: 3
    deinterleave: true
  placement:
    chip: 0
    cells:
    - {cell_id: rgen, x: 1, y: 5, face: south}
    - {cell_id: wctl, x: 1, y: 6, face: south}
    - {cell_id: store, x: 1, y: 7, face: west}
- name: hammingdecoder
  type: HammingDecoderBlock
  library: lattrex.official
  placement:
    chip: 0
    cells:
    - {cell_id: front, x: 3, y: 5, face: east}
    - {cell_id: fix, x: 4, y: 5, face: east}
- name: packkbits
  type: PackKBitsBlock
  library: lattrex.official
  params:
    k: 8
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 4, face: east}
connections:
- name: net1
  from: {block: unpackkbits, port: out}
  to: {block: hammingencoder, port: sample}
  route:
  - {x: 1, y: 1}
  - {x: 2, y: 1}
- name: net2
  from: {block: blockinterleaver, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 6, y: 3}
  - {x: 7, y: 3}
  - {x: 8, y: 3}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 10
- name: net3
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: blockinterleaver_2, port: sample}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 0, y: 3}
  - {x: 0, y: 4}
  - {x: 0, y: 5}
  - {x: 1, y: 5}
  stream_id: rx
- name: net4
  from: {block: hammingdecoder, port: out}
  to: {block: packkbits, port: sample}
  route:
  - {x: 4, y: 5}
  - {x: 5, y: 5}
  - {x: 6, y: 5}
  - {x: 7, y: 5}
  - {x: 8, y: 5}
- name: net5
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: crc16, port: sample}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 0, y: 3}
  stream_id: txcrc
- name: net6
  from: {block: hammingencoder, port: out}
  to: {block: blockinterleaver, port: sample}
  route:
  - {x: 4, y: 1}
  - {x: 5, y: 1}
- name: net7
  from: {block: crc16, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 1, y: 3}
  - {x: 2, y: 3}
  - {x: 3, y: 3}
  - {x: 4, y: 3}
  - {x: 5, y: 3}
  - {x: 5, y: 2}
  - {x: 5, y: 1}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 11
- name: net8
  from: {block: blockinterleaver_2, port: out}
  to: {block: hammingdecoder, port: sample}
  route:
  - {x: 1, y: 7}
  - {x: 2, y: 7}
  - {x: 2, y: 6}
  - {x: 2, y: 5}
- name: net9
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: unpackkbits, port: byte}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  stream_id: tx
- name: net10
  from: {block: packkbits, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 8, y: 4}
  - {x: 9, y: 4}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 5
