options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'FFT128 across TWO DIES: chip 0 runs stage 0, chip 1 runs stages
      1..6, joined by the inter-chip crossing. Driven through the placeKYT multi-chip
      GNURadio server.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fft128_2die_demo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Kyttar FFT128 \u2014 a 128-point transform across two dies"
    window_size: (1500,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: burst_len
  id: variable
  parameters:
    comment: one 128-bin frame past the 127-sample latency
    value: '384'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: scope_points
  id: variable
  parameters:
    comment: '< burst_len: a QT time_sink never paints a buffer it cannot fill'
    value: '320'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 360
    - 12
    rotation: 0
    state: enabled
- name: server_port
  id: variable
  parameters:
    comment: placeKYT's default host port (Run as GNURadio Server binds 58950; change
      if it prints another)
    value: '58950'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 12
    rotation: 0
    state: enabled
- name: stim
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: two complex tones (bins 9 and 37 of 128)
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: complex
    vector: '[0.45*__import__(''cmath'').exp(2j*3.141592653589793*9*n/128) + 0.35*__import__(''cmath'').exp(2j*3.141592653589793*37*n/128)
      for n in range(burst_len)]'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 40
    - 200
    rotation: 0
    state: enabled
- name: kyt_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: stream 'fft' -> chip 0's head (chip/hop resolved in placeKYT)
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    output_words: '"q15"'
    port_name: '"x16_in"'
    pipelined: 'False'
    repeat: 'no'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"fft"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 290
    - 200
    rotation: 0
    state: enabled
- name: die0
  id: kyttar_fft128_die0
  parameters:
    affinity: ''
    alias: ''
    comment: "chip 0 \u2014 stage 0 (period-64 octant fold). Its output is a PARTIAL\
      \ transform, not bins."
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 540
    - 200
    rotation: 0
    state: enabled
- name: die1
  id: kyttar_fft128_die1
  parameters:
    affinity: ''
    alias: ''
    comment: "chip 1 \u2014 stages 1..6. Output = the transform's bins, BIT-REVERSED,\
      \ scale FFT/128."
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 200
    rotation: 0
    state: enabled
- name: kyt_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: recovered bins off chip 1's x16_out (the chain tail)
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: complex
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: server_port
    server_repeat: 'True'
    stream_id: '"fft"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 920
    - 200
    rotation: 0
    state: enabled
- name: bins
  id: qtgui_time_sink_x
  parameters:
    alpha1: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    alpha10: '1.0'
    color1: blue
    color2: blue
    color3: blue
    color4: blue
    color5: blue
    color6: blue
    color7: blue
    color8: blue
    color9: blue
    color10: blue
    label1: FFT128 output words (I, Q interleaved)
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    label10: Signal 10
    affinity: ''
    alias: ''
    autoscale: 'True'
    axislabels: 'True'
    comment: "the transform's bins off chip 1. Slot k of each 128-bin frame carries\
      \ bin bit_reverse_7(k) \u2014 the DIF order, no reorder buffer."
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    legend: 'True'
    name: '"FFT128 output words (I, Q interleaved)"'
    nconnections: '1'
    size: scope_points
    srate: scope_points
    type: float
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    ylabel: Magnitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 180
    rotation: 0
    state: enabled
- name: in_mag
  id: blocks_complex_to_mag
  parameters:
    affinity: ''
    alias: ''
    comment: '|input| for comparison'
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 420
    rotation: 0
    state: enabled
- name: in_scope
  id: qtgui_time_sink_x
  parameters:
    alpha1: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    alpha10: '1.0'
    color1: blue
    color2: blue
    color3: blue
    color4: blue
    color5: blue
    color6: blue
    color7: blue
    color8: blue
    color9: blue
    color10: blue
    label1: input |x[n]| (two tones)
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    label10: Signal 10
    affinity: ''
    alias: ''
    autoscale: 'True'
    axislabels: 'True'
    comment: the stimulus driving the pair
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    legend: 'True'
    name: '"input |x[n]| (two tones)"'
    nconnections: '1'
    size: scope_points
    srate: scope_points
    type: float
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    ylabel: Magnitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 400
    rotation: 0
    state: enabled
connections:
- - stim
  - '0'
  - kyt_src
  - '0'
- - kyt_src
  - '0'
  - die0
  - '0'
- - die0
  - '0'
  - die1
  - '0'
- - die1
  - '0'
  - kyt_sink
  - '0'
- - kyt_sink
  - '0'
  - bins
  - '0'
- - stim
  - '0'
  - in_mag
  - '0'
- - in_mag
  - '0'
  - in_scope
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
