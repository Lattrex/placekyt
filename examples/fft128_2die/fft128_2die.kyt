project:
  format_version: 1
  name: fft128_2die
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
- id: 1
  label: Chip 1
  position: {x: 768.0, y: 0.0}
inter_chip_connections:
- from: {chip: 0, port: x16_out}
  to: {chip: 1, port: x16_in}
blocks:
- name: fft128die0
  type: FFT128Die0
  library: lattrex.official
  placement:
    chip: 0
    cells:
    - {cell_id: s0_ctl, x: 2, y: 0, face: east}
    - {cell_id: s0_sumi, x: 3, y: 0, face: south}
