connections:
- name: c0_in_xi
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: fft128die0, port: xi}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  - {x: 2, y: 0}
  stream_id: fft
- name: c0_in_xq
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: fft128die0, port: xq}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  - {x: 2, y: 0}
  stream_id: fft
- name: c0_out
  from: {block: fft128die0, port: out_i}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 2, y: 1}
  - {x: 1, y: 1}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 0, y: 3}
  - {x: 0, y: 4}
  - {x: 1, y: 4}
