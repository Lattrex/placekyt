    - {cell_id: s0_d5, x: 7, y: 3, face: west}
    - {cell_id: s0_d6, x: 6, y: 3, face: west}
    - {cell_id: s0_d7, x: 5, y: 3, face: west}
    - {cell_id: s0_d8, x: 4, y: 3, face: west}
    - {cell_id: s0_d9, x: 3, y: 3, face: west}
    - {cell_id: s0_d10, x: 2, y: 3, face: west}
    - {cell_id: s0_d11, x: 1, y: 3, face: north}
