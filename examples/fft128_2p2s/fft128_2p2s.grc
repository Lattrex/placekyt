    alpha8: '1.0'
    alpha9: '1.0'
    alpha10: '1.0'
    color1: '"blue"'
    color2: '"red"'
    color3: '"blue"'
    color4: '"blue"'
    color5: '"blue"'
    color6: '"blue"'
    color7: '"blue"'
    color8: '"blue"'
    color9: '"blue"'
    color10: '"blue"'
    label1: on-chip FFT128 power spectrum (bin k = k*samp_rate/128 Hz)
    label2: ''
