    minoutbuf: '0'
    name: '"On-chip FFT32 spectrum (natural bin order, dBFS)"'
    nconnections: '1'
    ref_level: '0'
    showports: 'False'
    update_time: '0.10'
    vlen: n_fft
    width1: '3'
    width10: '1'
