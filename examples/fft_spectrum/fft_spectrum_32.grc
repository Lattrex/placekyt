    ymax: '5'
    ymin: '-95'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 348]
    rotation: 0
    state: enabled

connections:
- [src, '0', ksrc, '0']
- [ksrc, '0', fft, '0']
- [fft, '0', mag2, '0']
- [mag2, '0', ksink, '0']
- [ksink, '0', unreverse, '0']
- [unreverse, '0', to_db, '0']
- [to_db, '0', spectrum_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
