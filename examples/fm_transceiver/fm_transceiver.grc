options:
  parameters:
    author: Kyttar
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "FM TRANSCEIVER from REAL Kyttar blocks. SEPARATE TX chain\
      \ (audio -> frequency_modulator -> FM passband, stream 'tx') and SEPARATE\
      \ RX chain (complex FM I/Q -> quadrature_demod -> recovered audio, stream\
      \ 'rx') sharing ONE chip by stream_id, like the AM transceiver. Verified\
      \ |corr| ~ 1.0. Imports + auto-P&R-routes into placeKYT."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fm_transceiver
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "FM transceiver (on-chip, real blocks) — TX modulate + RX demodulate"
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:

- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled

- name: n_samp
  id: variable
  parameters:
    comment: audio burst length
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled

- name: server_port
  id: variable
  parameters:
    comment: placeKYT GNURadio-server port
    value: '58950'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 12]
    rotation: 0
    state: enabled

- name: import_stim
  id: import
  parameters:
    imports: from gnuradio.kyttar import fm_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 12]
    rotation: 0
    state: enabled

- name: tx_audio
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: TX audio (two tones) -> chip (stream 'tx'); finite, no repeat
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vector: stim.tx_audio(n_samp)
    repeat: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 120]
    rotation: 0
    state: enabled

- name: tx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: n_samp
    comment: TX audio -> chip x16_in (shared duplex port, stream 'tx')
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 120]
    rotation: 0
    state: enabled

- name: tx_vco
  id: kyttar_frequency_modulator
  parameters:
    affinity: ''
    alias: ''
    comment: 'FM modulate: phi += sensitivity*audio; out = exp(j*phi)'
    device_id: '"kyttar_0"'
    sensitivity: 0.2945243112740431
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 120]
    rotation: 0
    state: enabled

- name: tx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: FM passband (I/Q interleaved) <- chip x16_out (stream 'tx')
    device_id: '"kyttar_0"'
    in_type: complex
    num_channels: '1'
    port_name: '"x16_out"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 120]
    rotation: 0
    state: enabled

- name: tx_passband
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'True'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: 'FM passband (TX)'
    legend: 'True'
    marker1: '-1'
    name: 'FM passband (TX)'
    nconnections: '1'
    size: stim.points(n_samp)
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: ''
    type: float
    update_time: '0.10'
    width1: '1'
    ylabel: 'Amplitude'
    ymax: '1'
    ymin: '-1'
    yunit: ''
    grid_color1: 'blue'
    alpha1: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 40]
    rotation: 0
    state: enabled

- name: fm_rf
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'RX input: the complex FM passband (same audio+sensitivity); I/Q, no repeat'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vector: stim.fm_iq(n_samp)
    repeat: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 320]
    rotation: 0
    state: enabled

- name: rx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: n_samp
    comment: complex FM I/Q -> chip x16_in (shared duplex port, stream 'rx')
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 320]
    rotation: 0
    state: enabled

- name: rx_demod
  id: kyttar_quadrature_demod
  parameters:
    affinity: ''
    alias: ''
    comment: 'FM demod: y = gain*arg(x[n]*conj(x[n-1]))'
    device_id: '"kyttar_0"'
    gain: 3.3953054526271007
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 320]
    rotation: 0
    state: enabled

- name: rx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: recovered audio <- chip x16_out (stream 'rx')
    device_id: '"kyttar_0"'
    num_channels: '1'
    port_name: '"x16_out"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 320]
    rotation: 0
    state: enabled

- name: rx_audio
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'True'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: 'recovered audio (RX)'
    legend: 'True'
    marker1: '-1'
    name: 'recovered audio (RX)'
    nconnections: '1'
    size: stim.points(n_samp)
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: ''
    type: float
    update_time: '0.10'
    width1: '1'
    ylabel: 'Amplitude'
    ymax: '1'
    ymin: '-1'
    yunit: ''
    grid_color1: 'green'
    alpha1: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 240]
    rotation: 0
    state: enabled

connections:
- [tx_audio, '0', tx_src, '0']
- [tx_src, '0', tx_vco, '0']
- [tx_vco, '0', tx_sink, '0']
- [tx_sink, '0', tx_passband, '0']
- [fm_rf, '0', rx_src, '0']
- [rx_src, '0', rx_demod, '0']
- [rx_demod, '0', rx_sink, '0']
- [rx_sink, '0', rx_audio, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
