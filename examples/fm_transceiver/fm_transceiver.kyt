project:
  format_version: 1
  name: FM transceiver (on-chip, real blocks) — TX modulate + RX demodulate
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: quadraturedemod
  type: QuadratureDemodBlock
  library: lattrex.official
  params:
    gain: 3.3953054526271007
  placement:
    chip: 0
    cells:
    - {cell_id: conjmult, x: 1, y: 1, face: east}
    - {cell_id: gain, x: 2, y: 1, face: east}
- name: frequencymodulator
  type: FrequencyModulatorBlock
  library: lattrex.official
  params:
    sensitivity: 0.2945243112740431
    pipeline_lock: false
  placement:
    chip: 0
    cells:
    - {cell_id: phase, x: 1, y: 2, face: east}
    - {cell_id: sin_fold, x: 2, y: 2, face: east}
    - {cell_id: sin_even, x: 3, y: 2, face: east}
    - {cell_id: sin_odd, x: 4, y: 2, face: east}
    - {cell_id: sin_interp, x: 5, y: 2, face: south}
    - {cell_id: cos_fold, x: 5, y: 3, face: west}
    - {cell_id: cos_even, x: 4, y: 3, face: west}
    - {cell_id: cos_odd, x: 3, y: 3, face: west}
    - {cell_id: cos_interp, x: 2, y: 3, face: west}
    - {cell_id: emit, x: 1, y: 3, face: south}
    orientation:
    - ccw
    - mirror_v
connections:
- name: net1
  from: {block: quadraturedemod, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 2, y: 1}
  - {x: 3, y: 1}
  - {x: 4, y: 1}
  - {x: 5, y: 1}
  - {x: 6, y: 1}
  - {x: 7, y: 1}
  - {x: 8, y: 1}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 5
- name: net2
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: quadraturedemod, port: xi}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 1, y: 1}
  stream_id: rx
- name: net3
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: frequencymodulator, port: x}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 1, y: 2}
  stream_id: tx
- name: net4
  from: {block: frequencymodulator, port: yi}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 1, y: 3}
  - {x: 1, y: 4}
  - {x: 2, y: 4}
  - {x: 3, y: 4}
  - {x: 4, y: 4}
  - {x: 5, y: 4}
  - {x: 6, y: 4}
  - {x: 7, y: 4}
  - {x: 8, y: 4}
  - {x: 9, y: 4}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 10
- name: net5
  from: {block: frequencymodulator, port: yq}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 1, y: 3}
  - {x: 1, y: 4}
  - {x: 2, y: 4}
  - {x: 3, y: 4}
  - {x: 4, y: 4}
  - {x: 5, y: 4}
  - {x: 6, y: 4}
  - {x: 7, y: 4}
  - {x: 8, y: 4}
  - {x: 9, y: 4}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 11
