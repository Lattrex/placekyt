  id: blocks_deinterleave
  parameters:
    affinity: ''
    alias: ''
    blocksize: '1'
    comment: split the 3-word duty packet into the three per-phase duty streams. Deinterleave at 3 is
      the documented way to unpack this block's output.
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '3'
    type: float
