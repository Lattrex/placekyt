- name: clarke
  id: kyttar_clarke_transform
  parameters:
    affinity: ''
    alias: ''
    comment: "ON CHIP: the amplitude-invariant two-current Clarke. i_alpha = ia; i_beta = (ia + 2*ib)/sqrt(3).\
      \ One cell, a two-arm face-locking rendezvous \u2014 the two inputs MUST reach it on two different\
      \ faces."
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 788
    - 1047
    rotation: 0
    state: enabled
- name: ab_split
  id: blocks_complex_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: "type glue only \u2014 the importer splices this out, wiring Clarke's I rail to the rotation's\
      \ x and its Q rail to y. No cell is spent."
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1048
    - 1207
    rotation: 0
    state: enabled
