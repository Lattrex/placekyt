  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: "drains the measurement half's result: the rotor-frame currents (i_d, i_q) interleaved. Q15\
      \ floats \u2014 the sink emits word/32768."
    maxoutbuf: '0'
    minoutbuf: '0'
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: complex
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'True'
    stream_id: '"ia"'
  states:
