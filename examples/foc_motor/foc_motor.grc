- name: idq_split
  id: blocks_deinterleave
  parameters:
    affinity: ''
    alias: ''
    blocksize: '1'
    comment: "split the recovered interleaved [i_d, i_q, i_d, i_q, ...] float stream into the two rails\
      \ the error former subtracts from. The kyttar sink emits FLOAT even for a complex on-chip stream\
      \ \u2014 the rails come back interleaved."
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '2'
    type: float
    vlen: '1'
  states:
