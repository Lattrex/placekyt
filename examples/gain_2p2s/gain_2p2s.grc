options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: '2P2S multi-chip demo: FOUR gain streams (one per chip) across two
      parallel daisy-chains, multiplexed over the placeKYT multi-chip GNURadio server.
      Each stream -> 0.5x.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: gain_2p2s_demo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Kyttar 2P2S \u2014 four multiplexed gain streams (0.5x each)"
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: burst_len
  id: variable
  parameters:
    comment: ''
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: gain_a
  id: variable_qtgui_range
  parameters:
    comment: LIVE gain for stream A (chip0's cell)
    gui_hint: ''
    label: gain A (chip0, live)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-1.0'
    step: '0.01'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: gain_b
  id: variable_qtgui_range
  parameters:
    comment: LIVE gain for stream B (chip1's cell)
    gui_hint: ''
    label: gain B (chip1, live)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-1.0'
    step: '0.01'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [690, 12]
    rotation: 0
    state: enabled
- name: gain_c
  id: variable_qtgui_range
  parameters:
    comment: LIVE gain for stream C (chip2's cell)
    gui_hint: ''
    label: gain C (chip2, live)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-1.0'
    step: '0.01'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [860, 12]
    rotation: 0
    state: enabled
- name: gain_d
  id: variable_qtgui_range
  parameters:
    comment: LIVE gain for stream D (chip3's cell)
    gui_hint: ''
    label: gain D (chip3, live)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-1.0'
    step: '0.01'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1030, 12]
    rotation: 0
    state: enabled
- name: server_port
  id: variable
  parameters:
    comment: placeKYT's default host port (Run as GNURadio Server binds 58950; change
      if it prints another)
    value: '58950'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 12]
    rotation: 0
    state: enabled
- name: gainA
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    block_name: '"gain"'
    comment: live gain (chip0 = gain)
    device_id: '"kyttar_0"'
    gain: gain_a
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 180]
    rotation: 0
    state: enabled
- name: gainB
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    block_name: '"gain_1"'
    comment: live gain (chip1 = gain_1)
    device_id: '"kyttar_0"'
    gain: gain_b
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 400]
    rotation: 0
    state: enabled
- name: gainC
