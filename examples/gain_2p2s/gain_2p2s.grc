    coordinate: [520, 840]
    rotation: 0
    state: enabled
- name: msinkA
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: stream A recovered (0.5x)
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: server_port
    server_repeat: 'True'
    stream_id: '"A"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [750, 180]
    rotation: 0
