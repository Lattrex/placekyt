- name: msrcA
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: stream A -> placeKYT (stream_id only; chip/hop resolved there)
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    repeat: 'yes'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"A"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [290, 180]
    rotation: 0
    state: enabled
