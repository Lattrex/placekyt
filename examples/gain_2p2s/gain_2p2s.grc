- name: srcA
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: stream A sine (taps chip0's gain)
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: float
    vector: '[0.8*float(__import__(''math'').sin(2*3.141592653589793*2*n/burst_len))
      for n in range(burst_len)]'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 180]
    rotation: 0
    state: enabled
- name: srcB
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: stream B sine (taps chip1's gain)
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: float
    vector: '[0.8*float(__import__(''math'').sin(2*3.141592653589793*3*n/burst_len))
      for n in range(burst_len)]'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 400]
    rotation: 0
    state: enabled
- name: srcC
