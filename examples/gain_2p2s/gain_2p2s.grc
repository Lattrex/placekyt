options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: '2P2S multi-chip demo: two parallel gain daisy-chains driven over
      the placeKYT multi-chip GNURadio server. Each chain -> 0.25x.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: gain_2p2s_demo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Kyttar 2P2S \u2014 two parallel chains (0.25x each)"
    window_size: (1200,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: burst_len
  id: variable
  parameters:
    comment: ''
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: server_port
  id: variable
  parameters:
    comment: set to the port placeKYT prints
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 360
    - 12
    rotation: 0
    state: enabled
- name: srcA
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: chain A sine -> chip0 head
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: float
    vector: '[0.8*float(__import__(''math'').sin(2*3.141592653589793*2*n/burst_len))
      for n in range(burst_len)]'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 40
    - 200
    rotation: 0
    state: enabled
- name: msrcA
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: stream A -> chip0 (chain head)
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"A"'
    pipelined: 'False'
    schedule: '"interleaved"'
    chip_id: '0'
    out_chip: '1'
    entry_addr: '28'
    hop_count: '30'
    data_addrs: '"0"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 200
    rotation: 0
    state: enabled
- name: msinkA
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: chain A tail (chip1 x16_out), 0.25x
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: server_port
    server_repeat: 'False'
    stream_id: '"A"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 200
    rotation: 0
    state: enabled
- name: time_sink_A
  id: qtgui_time_sink_x
  parameters:
    alpha1: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    alpha10: '1.0'
    color1: blue
    color2: blue
    color3: blue
    color4: blue
    color5: blue
    color6: blue
    color7: blue
    color8: blue
    color9: blue
    color10: blue
    label1: input
    label2: chain A out (0.25x)
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    label10: Signal 10
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    comment: 'chain A: input vs 0.25x'
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    legend: 'True'
    name: '"Chain A"'
    nconnections: '2'
    size: burst_len
    srate: burst_len
    type: float
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    ylabel: Amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 200
    rotation: 0
    state: enabled
- name: srcB
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: chain B sine -> chip2 head
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: float
    vector: '[0.8*float(__import__(''math'').sin(2*3.141592653589793*3*n/burst_len))
      for n in range(burst_len)]'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 40
    - 460
    rotation: 0
    state: enabled
- name: msrcB
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: stream B -> chip2 (chain head)
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"B"'
    pipelined: 'False'
    schedule: '"interleaved"'
    chip_id: '2'
    out_chip: '3'
    entry_addr: '28'
    hop_count: '30'
    data_addrs: '"0"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 460
    rotation: 0
    state: enabled
- name: msinkB
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: chain B tail (chip3 x16_out), 0.25x
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: server_port
    server_repeat: 'False'
    stream_id: '"B"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 460
    rotation: 0
    state: enabled
- name: time_sink_B
  id: qtgui_time_sink_x
  parameters:
    alpha1: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    alpha10: '1.0'
    color1: blue
    color2: red
    color3: blue
    color4: blue
    color5: blue
    color6: blue
    color7: blue
    color8: blue
    color9: blue
    color10: blue
    label1: input
    label2: chain B out (0.25x)
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    label10: Signal 10
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    comment: 'chain B: input vs 0.25x'
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    legend: 'True'
    name: '"Chain B"'
    nconnections: '2'
    size: burst_len
    srate: burst_len
    type: float
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    ylabel: Amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 460
    rotation: 0
    state: enabled
connections:
- - srcA
  - '0'
  - msrcA
  - '0'
- - msinkA
  - '0'
  - time_sink_A
  - '1'
- - srcA
  - '0'
  - time_sink_A
  - '0'
- - srcB
  - '0'
  - msrcB
  - '0'
- - msinkB
  - '0'
  - time_sink_B
  - '1'
- - srcB
  - '0'
  - time_sink_B
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
