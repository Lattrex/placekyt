options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: HARDWARE Kyttar TWO-GAIN MULTIPLEX demo. Two independent gain blocks
      share ONE input port (x16_in) and ONE output port (x16_out) on the same chip,
      distinguished by stream tags (stream_id "a"/"b") — the multiplexed shared-port
      model, like the AM/SSB transceiver examples. Each chain has its own sig_source,
      kyttar_source, kyttar_gain, kyttar_sink, and its own LIVE gain slider. Toggle
      Hardware Mode in placeKYT, Run as GNURadio Server, then Execute here. The plot
      shows both gained outputs; move each slider to retune that stream's gain live.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: gain_hw
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Kyttar TWO-GAIN multiplex — HARDWARE streaming (live sliders)"
    window_size: (1200,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: streaming sample rate into the chip (samples/s)
    value: '4000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: server_port
  id: variable
  parameters:
    comment: placeKYT prints this on "Run as GNURadio Server"
    value: '58950'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 8]
    rotation: 0
    state: enabled
- name: gain_a
  id: variable_qtgui_range
  parameters:
    comment: LIVE gain for stream A (retunes cell A's coefficient)
    gui_hint: ''
    label: gain A
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: '-1.0'
    step: '0.01'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 8]
    rotation: 0
    state: enabled
- name: gain_b
  id: variable_qtgui_range
  parameters:
    comment: LIVE gain for stream B (retunes cell B's coefficient)
    gui_hint: ''
    label: gain B
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: '-1.0'
    step: '0.01'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 8]
    rotation: 0
    state: enabled
# ---------------- stream A chain ----------------
- name: src_a
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.8'
    comment: stream A stimulus (sine, freq 3)
    freq: '3'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SIN_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 180.0]
    rotation: 0
    state: enabled
- name: msrc_a
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: '0'
    comment: stream A -> chip x16_in (stream_id "a")
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    repeat: 'yes'
    server_port: server_port
    stream_id: '"a"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 156.0]
    rotation: 0
    state: enabled
- name: gain_blk_a
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    block_name: '"gain"'
    comment: gain block A (live gain_a slider)
    device_id: '"kyttar_0"'
    gain: gain_a
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 188.0]
    rotation: 0
    state: enabled
- name: msink_a
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: stream A output <- chip x16_out (stream_id "a")
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: server_port
    server_repeat: 'True'
    stream_id: '"a"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 132.0]
    rotation: 0
    state: enabled
# ---------------- stream B chain ----------------
- name: src_b
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.8'
    comment: stream B stimulus (sine, freq 7)
    freq: '7'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SIN_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 420.0]
    rotation: 0
    state: enabled
- name: msrc_b
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: '0'
    comment: stream B -> chip x16_in (stream_id "b")
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    repeat: 'yes'
    server_port: server_port
    stream_id: '"b"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 396.0]
    rotation: 0
    state: enabled
- name: gain_blk_b
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    block_name: '"gain_2"'
    comment: gain block B (live gain_b slider)
    device_id: '"kyttar_0"'
    gain: gain_b
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 428.0]
    rotation: 0
    state: enabled
- name: msink_b
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: stream B output <- chip x16_out (stream_id "b")
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: server_port
    server_repeat: 'True'
    stream_id: '"b"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 372.0]
    rotation: 0
    state: enabled
# ---------------- shared plot ----------------
- name: time_sink
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: cyan
    color3: red
    color4: magenta
    color5: green
    color6: yellow
    color7: black
    color8: dark red
    color9: dark green
    comment: A in/out (blue/cyan) vs B in/out (red/magenta)
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: A input
    label10: Signal 10
    label2: A gained
    label3: B input
    label4: B gained
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Two multiplexed gain streams (hardware): A & B in/out"'
    nconnections: '4'
    size: '1024'
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: amplitude
    ymax: '1.2'
    ymin: '-1.2'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1016, 240.0]
    rotation: 0
    state: enabled

connections:
- [src_a, '0', msrc_a, '0']
- [msrc_a, '0', gain_blk_a, '0']
- [gain_blk_a, '0', msink_a, '0']
- [src_a, '0', time_sink, '0']
- [msink_a, '0', time_sink, '1']
- [src_b, '0', msrc_b, '0']
- [msrc_b, '0', gain_blk_b, '0']
- [gain_blk_b, '0', msink_b, '0']
- [src_b, '0', time_sink, '2']
- [msink_b, '0', time_sink, '3']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
