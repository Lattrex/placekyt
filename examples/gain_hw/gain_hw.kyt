project:
  format_version: 1
  name: Untitled
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
blocks:
- name: gain
  type: GainBlock
  library: lattrex.official
  params:
    gain: 0.5
    gain_range: 15
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 4, y: 1, face: east}
- name: gain_1
  type: GainBlock
  library: lattrex.official
  params:
    gain: 0.5
    gain_range: 15
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 4, y: 2, face: east}
connections:
- name: x16_in_to_gain
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: gain, port: sample}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  - {x: 2, y: 0}
  - {x: 3, y: 0}
  - {x: 3, y: 1}
  - {x: 4, y: 1}
  stream_id: a
- name: x16_in_to_gain_1
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: gain_1, port: sample}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  - {x: 2, y: 0}
  - {x: 3, y: 0}
  - {x: 3, y: 1}
  - {x: 3, y: 2}
  - {x: 4, y: 2}
  stream_id: b
- name: gain_to_x16_out
  from: {block: gain, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 4, y: 1}
  - {x: 5, y: 1}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 0
- name: gain_1_to_x16_out
  from: {block: gain_1, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 4, y: 2}
  - {x: 5, y: 2}
  - {x: 5, y: 1}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 1
