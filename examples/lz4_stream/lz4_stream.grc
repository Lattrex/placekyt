options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'LZ4 COMPRESSION as a variable-rate stream on one placeKYT array:
      the SRAM-panel-backed LZ4 Encoder and LZ4 Decoder — TWO panel-backed blocks,
      the design limit — share the chip''s single panel port pair. A 1 KB payload
      that switches character mid-stream (512 highly repetitive bytes, then 512
      random bytes) is compressed on chip; the compressed stream comes back to
      this flowgraph, is displayed, and is re-injected into the on-chip decoder,
      which recovers the payload byte-exactly. The client-side hand-off is the
      panel contract: the per-sample paced server finishes the whole encode
      before the first compressed byte exists, so the two panel clients never
      burst at the same time. What to watch: the encoder output scope holds a
      WORST-CASE buffer (1044 = 1024 + 1024/255 + 16, the LZ4 incompressible
      bound) but only ~540 bytes per batch arrive — the first 512 input bytes
      compress ~16:1, the random half is ~1:1 — a data-dependent output rate no
      fixed-rate DSP pipeline can produce. Both kyttar sources set Output words
      = Raw (bytes are integer words; the raw convention is symmetric, so no
      q15 scaling on either side). The 256 at the end of the payload vector is
      the encoder''s out-of-band end-of-block sentinel, not a byte.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: lz4_stream
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LZ4 stream (variable-rate compression on one array)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'nominal display rate for the scopes'
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 100
    rotation: 0
    state: enabled
- name: payload_len
  id: variable
  parameters:
    comment: '1024 payload bytes + the end-of-block sentinel word (256)'
    value: '1025'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 180
    rotation: 0
    state: enabled
- name: cmp_len
  id: variable
  parameters:
    comment: 'compressed length of the SHIPPED payload (measured; deterministic). The cmp source dispatches after exactly this many compressed bytes arrive. Update it if you change the payload - the encoder output scope shows the real length.'
    value: '540'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 260
    rotation: 0
    state: enabled
- name: cmp_worst
  id: variable
  parameters:
    comment: 'WORST-CASE compressed length for 1024 input bytes (1024 + 1024/255 + 16, the LZ4 incompressible expansion bound ~+0.5%) - the encoder-output scope buffer is sized to it'
    value: '1044'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 340
    rotation: 0
    state: enabled
