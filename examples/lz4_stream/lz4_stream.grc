    bus_structure: null
    coordinate:
    - 680
    - 328
    rotation: 0
    state: enabled
- name: dec
  id: kyttar_lz4_decoder
  parameters:
    affinity: ''
    alias: ''
    comment: 'SRAM-backed streaming LZ4 block-format decoder (8 cells + the
      panel history window). addr_base stays 0 (its proven configuration): the
      controller''s addr_base offsets only the LOOKUP path, so a based
      read-write client would read a region it never wrote. The decoder reuses
      [0, len) SEQUENTIALLY after the encoder - every read is of an address the
      decoder itself wrote earlier in the same batch.'
    maxoutbuf: '0'
    minoutbuf: '0'
    addr_base: '0'
    device_id: '"kyttar_0"'
    emit_entry: '0'
    emit_hop: '2'
    out_dest: '0'
    panel_hop: '1'
    read_jp_desc: '0'
    read_wr_desc: '0'
    window_words: '65536'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 872
    - 336
    rotation: 0
    state: enabled
