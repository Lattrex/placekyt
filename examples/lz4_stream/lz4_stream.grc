- name: cmp_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    comment: 'the compressed bytes back into the on-chip LZ4 decoder. The
      client-side hand-off is the panel contract: the per-sample paced server
      finished the whole encode before the first compressed byte existed, so
      the two panel clients never burst at the same time. Dispatches after
      cmp_len bytes (one compressed batch).'
    maxoutbuf: '0'
    minoutbuf: '0'
    burst_len: cmp_len
    complex_in: float
    device_id: '"kyttar_0"'
    num_channels: '1'
    output_words: '"raw"'
    pipelined: 'no'
    port_name: '"x16_in"'
    repeat: 'no'
