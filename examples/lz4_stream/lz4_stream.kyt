project:
  format_version: 1
  name: LZ4 stream (variable-rate compression on one array)
  version: '1.0'
chip_type: kyttar_10x12
chips:
- id: 0
  label: Chip 0
  position: {x: 0.0, y: 0.0}
panels:
- id: 0
  label: LZ4 input window (32768 x 16b) + hash table (4096 slots) + LZ4 history 
    window (65536 x 16b)
  mirrored: true
  position: {x: 240.0, y: 840.0}
  ports:
  - {name: x16_in, direction: input, width: 16, face: east}
  - {name: x1_in, direction: input, width: 1, face: east}
  - {name: x16_out, direction: output, width: 16, face: west}
  - {name: x1_out, direction: output, width: 1, face: west}
panel_connections:
- panel: {id: 0, port: x1_in}
  chip: {id: 0, port: x1_out}
- panel: {id: 0, port: x1_out}
  chip: {id: 0, port: x1_in}
blocks:
- name: lz4decoder
  type: LZ4DecoderBlock
  library: lattrex.official
  params:
    window_words: 65536
    panel_hop: 5
    read_wr_desc: 25384
    read_jp_desc: 29488
    addr_base: 0
    emit_hop: 4
    out_dest: 5
    emit_entry: 9
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 4, y: 9, face: west}
    - {cell_id: 1, x: 3, y: 9, face: west}
    - {cell_id: 2, x: 2, y: 9, face: south}
    - {cell_id: 3, x: 2, y: 10, face: east}
    - {cell_id: 4, x: 3, y: 10, face: east}
    - {cell_id: 5, x: 4, y: 10, face: north}
    - {cell_id: 6, x: 6, y: 10, face: south}
    - {cell_id: 7, x: 5, y: 10, face: east}
- name: lz4encoder
  type: LZ4EncoderBlock
  library: lattrex.official
  params:
    window_words: 32768
    hash_bits: 12
    panel_hop: 6
    read_wr_desc: 25509
    read_jp_desc: 29609
    addr_base: 0
    emit_hop: 10
    out_dest: 2
    emit_entry: 0
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 2, y: 5, face: south}
    - {cell_id: 1, x: 2, y: 7, face: north}
    - {cell_id: 2, x: 6, y: 7, face: west}
    - {cell_id: 3, x: 3, y: 6, face: east}
    - {cell_id: 4, x: 4, y: 6, face: east}
    - {cell_id: 5, x: 2, y: 6, face: east}
    - {cell_id: 6, x: 5, y: 6, face: east}
    - {cell_id: 7, x: 7, y: 6, face: south}
    - {cell_id: 8, x: 7, y: 7, face: west}
    - {cell_id: 9, x: 8, y: 6, face: south}
    - {cell_id: 10, x: 5, y: 7, face: west}
    - {cell_id: 11, x: 8, y: 7, face: south}
    - {cell_id: 12, x: 4, y: 7, face: west}
    - {cell_id: 13, x: 3, y: 7, face: west}
    - {cell_id: 14, x: 6, y: 6, face: east}
- name: xoI
  type: CrossoverBlock
  library: lattrex.official
  params:
    face_a: east
    hop_a: 6
    restore_face: south
    dest_a: 6
    entry_a: 15
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 0, y: 1, face: south}
- name: xoT
  type: CrossoverBlock
  library: lattrex.official
  params:
    face_a: north
    hop_a: 2
    restore_face: east
    dest_a: 5
    entry_a: 8
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 1, y: 8, face: east}
- name: xoR
  type: CrossoverBlock
  library: lattrex.official
  params:
    face_a: north
    hop_a: 3
    restore_face: east
    dest_a: 5
    entry_a: 9
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 1, y: 11, face: east}
- name: xoO
  type: CrossoverBlock
  library: lattrex.official
  params:
    face_a: east
    hop_a: 11
    restore_face: south
    dest_a: 22
    entry_a: 0
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 9, face: south}
connections:
- name: i2
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: lz4decoder, port: byte}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  - {x: 0, y: 2}
  - {x: 0, y: 3}
  - {x: 0, y: 4}
  - {x: 0, y: 5}
  - {x: 0, y: 6}
  - {x: 0, y: 7}
  - {x: 0, y: 8}
  - {x: 1, y: 8}
  - {x: 2, y: 8}
  - {x: 3, y: 8}
  - {x: 4, y: 8}
  stream_id: cmp
- name: i1a
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: xoI, port: in}
  route:
  - {x: 0, y: 0}
  - {x: 0, y: 1}
  stream_id: raw
  entry_override: 9
- name: i1b
  from: {block: xoI, port: out}
  to: {block: lz4encoder, port: b}
  route:
  - {x: 1, y: 1}
  - {x: 2, y: 1}
  - {x: 2, y: 2}
  - {x: 2, y: 3}
  - {x: 2, y: 4}
- name: r2
  from: {chip_port: {chip: 0, port: x1_in}}
  to: {block: lz4decoder, port: b}
  route:
  - {x: 0, y: 11}
  - {x: 1, y: 11}
  - {x: 2, y: 11}
  - {x: 3, y: 11}
  - {x: 4, y: 11}
- name: r1a
  from: {chip_port: {chip: 0, port: x1_in}}
  to: {block: xoR, port: in}
  route:
  - {x: 0, y: 11}
  - {x: 1, y: 11}
  entry_override: 9
- name: r1b
  from: {block: xoR, port: out}
  to: {block: xoT, port: in}
  route:
  - {x: 1, y: 10}
  - {x: 1, y: 9}
  - {x: 1, y: 8}
  entry_override: 9
- name: r1c
  from: {block: xoT, port: out}
  to: {block: lz4encoder, port: v}
  route:
  - {x: 1, y: 7}
- name: o1
  from: {block: lz4encoder, port: egress}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 6, y: 5}
  - {x: 6, y: 4}
  - {x: 6, y: 3}
  - {x: 6, y: 2}
  - {x: 6, y: 1}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 9, y: 0}
  out_tag: 2
- name: o2a
  from: {block: lz4decoder, port: egress}
  to: {block: xoO, port: in}
  route:
  - {x: 5, y: 9}
  - {x: 6, y: 9}
  - {x: 7, y: 9}
  - {x: 8, y: 9}
  entry_override: 9
- name: o2b
  from: {block: xoO, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 9, y: 9}
  - {x: 9, y: 8}
  - {x: 9, y: 7}
  - {x: 9, y: 6}
  - {x: 9, y: 5}
  - {x: 9, y: 4}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 22
- name: p1
  from: {block: lz4encoder, port: egress}
  to: {chip_port: {chip: 0, port: x1_out}}
  route:
  - {x: 8, y: 8}
  - {x: 8, y: 9}
  - {x: 8, y: 10}
  - {x: 8, y: 11}
  - {x: 9, y: 11}
- name: p2
  from: {block: lz4decoder, port: egress}
  to: {chip_port: {chip: 0, port: x1_out}}
  route:
  - {x: 6, y: 11}
  - {x: 7, y: 11}
  - {x: 8, y: 11}
  - {x: 9, y: 11}
