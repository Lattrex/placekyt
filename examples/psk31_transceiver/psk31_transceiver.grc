options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'A FULL PSK31 TRANSCEIVER on one placeKYT chip: TX (chars -> SRAM-backed
      Varicode encoder -> differential BPSK -> hold x8 -> raised-cosine envelope)
      and RX (symbols -> BPSK slicer -> diff decoder -> SRAM-backed Varicode DECODER
      -> chars) duplexed by stream tags, with BOTH Varicode tables SHARING the single
      SRAM panel (the encoder''s table at addr_base 1024, clear of the decoder''s
      1..955 reverse map; every panel read carries its own push-read descriptors).
      PER-SAMPLE PACED (the panel contract; the server enforces it).'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: psk31_transceiver
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: PSK31 full transceiver (duplex, shared SRAM panel)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: scope display rate (8 sps x 31.25 Bd)
    value: '250'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 104
    - 12
    rotation: 0
    state: enabled
- name: imports
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 68
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: TX samples per symbol
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: msg
  id: variable
  parameters:
    comment: TX message chars
    value: '[ord(c) for c in ''CQ CQ DE KYTTAR'']'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 320
    - 12
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: ''
    value: len(msg)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 640
    - 12
    rotation: 0
    state: enabled
- name: rx_sig
  id: variable
  parameters:
    comment: differentially-encoded Varicode symbols for 'R 599 73' at symbol rate,
      mapped to +/-0.9 soft symbols -- exactly what a coherent PSK31 demodulator hands
      the slicer. Replace with a live demod feed.
    value: '[0.9 if int(v) else -0.9 for v in __import__(''itertools'').accumulate([int(c)
      for c in ''001010111100100101011011001101101110011011011100100110101101001111111100''],
      lambda a,x:(a+x)%2)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 12
    rotation: 0
    state: enabled
- name: rx_burst_len
  id: variable
  parameters:
    comment: ''
    value: len(rx_sig)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 12
    rotation: 0
    state: enabled
- name: msg_src
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: byte
    vector: msg
    vlen: '1'
  states:
