        56584, 43784, 54536, 61065, 44808, 56839, 55815, 43913, 55945, 44681, 
        47753, 48521, 43850, 64393, 63369, 64905, 45002, 46729, 47050, 45060, 
        48647, 48134, 46086, 49154, 62470, 46599, 44038, 53252, 62857, 48904, 
        55301, 60422, 61444, 57347, 64518, 57225, 43013, 47109, 40963, 56326, 
        62983, 54791, 57096, 47623, 60041, 44490, 56713, 44362, 46538, 60746]}
panel_connections:
- panel: {id: 0, port: x1_in}
  chip: {id: 0, port: x1_out}
- panel: {id: 0, port: x1_out}
  chip: {id: 0, port: x1_in}
blocks:
- name: varicodeencoder
  type: VaricodeEncoderBlock
  library: lattrex.official
  params:
    panel_hop: 2
    emit_hop: 1
    emit_dest: 0
    emit_entry: 23
    read_wr_desc: 25223
    read_jp_desc: 29322
    addr_base: 1024
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 11, face: east}
    - {cell_id: 1, x: 0, y: 1, face: east}
- name: diffencoder
  type: DiffEncoderBlock
  library: lattrex.official
  params:
    modulus: 2
    coding: DIFF_DIFFERENTIAL
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 1, y: 1, face: east}
- name: psksymbolmapper
  type: PSKSymbolMapperBlock
  library: lattrex.official
  params:
    modulation: bpsk
    symbol_table: []
    dimension: 1
    bpsk_bit0_positive: true
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 2, y: 1, face: east}
- name: repeat
  type: RepeatBlock
  library: lattrex.official
  params:
    interp: 8
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 3, y: 1, face: east}
- name: raisedcosineenvelope
  type: RaisedCosineEnvelopeBlock
  library: lattrex.official
  params:
    samples_per_symbol: 8
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 1, y: 3, face: east}
    - {cell_id: 1, x: 2, y: 3, face: east}
    - {cell_id: 2, x: 3, y: 3, face: east}
    - {cell_id: 3, x: 4, y: 3, face: east}
    - {cell_id: 4, x: 5, y: 3, face: east}
    - {cell_id: 5, x: 6, y: 3, face: east}
    - {cell_id: 6, x: 7, y: 3, face: east}
- name: bpskslicer
  type: BPSKSlicerBlock
  library: lattrex.official
  params:
    out_mode: bit
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 7, y: 8, face: west}
- name: diffdecoder
  type: DiffDecoderBlock
  library: lattrex.official
  params:
    modulus: 2
    coding: 0
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 6, y: 8, face: west}
- name: varicodedecoder
  type: VaricodeDecoderBlock
  library: lattrex.official
  params:
    panel_hop: 2
    read_addr_hop: 1
    char_dest: 25
    emit_entry: 2
    emit_hop: 11
    out_dest: 5
    read_dest: 6
    read_entry: 16
    read_wr_desc: 25505
    read_jp_desc: 29625
    emit_jump_entry: 23
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 9, y: 9, face: south}
    - {cell_id: 1, x: 1, y: 10, face: north}
    - {cell_id: 2, x: 9, y: 10, face: south}
- name: varicodeencoder_xover
  type: CrossoverBlock
  library: lattrex.official
  params:
    face_a: south
    hop_a: 5
    dest_a: 7
    entry_a: 18
    face_b: east
    hop_b: 8
    dest_b: 10
    entry_b: 0
    face_c: east
    hop_c: 8
    entry_c: 0
    dest_c: 5
    restore_face: south
  placement:
    chip: 0
    cells:
    - {cell_id: 0, x: 8, y: 6, face: south}
connections:
- name: net1
  from: {block: varicodeencoder, port: bits}
  to: {block: diffencoder, port: sample}
  route:
  - {x: 0, y: 1}
  - {x: 1, y: 1}
- name: net2
  from: {block: repeat, port: out}
  to: {block: raisedcosineenvelope, port: sample}
  route:
  - {x: 3, y: 1}
  - {x: 4, y: 1}
  - {x: 4, y: 2}
  - {x: 3, y: 2}
  - {x: 2, y: 2}
  - {x: 1, y: 2}
  - {x: 1, y: 3}
- name: net5
  from: {block: bpskslicer, port: out}
  to: {block: diffdecoder, port: sample}
  route:
  - {x: 7, y: 8}
  - {x: 6, y: 8}
- name: net6
  from: {block: diffdecoder, port: out}
  to: {block: varicodedecoder, port: bit}
  route:
  - {x: 6, y: 8}
  - {x: 6, y: 9}
  - {x: 7, y: 9}
  - {x: 8, y: 9}
- name: net7
  from: {block: psksymbolmapper, port: out}
  to: {block: repeat, port: x}
  route:
  - {x: 2, y: 1}
  - {x: 3, y: 1}
- name: net10
  from: {block: diffencoder, port: out}
  to: {block: psksymbolmapper, port: sample}
  route:
  - {x: 1, y: 1}
  - {x: 2, y: 1}
- name: varicodeencoder_panel_return
  from: {chip_port: {chip: 0, port: x1_in}}
  to: {block: varicodeencoder, port: word}
  route:
  - {x: 0, y: 11}
  - {x: 0, y: 10}
  - {x: 0, y: 9}
  - {x: 0, y: 8}
  - {x: 0, y: 7}
  - {x: 0, y: 6}
  - {x: 0, y: 5}
  - {x: 0, y: 4}
  - {x: 0, y: 3}
  - {x: 0, y: 2}
  - {x: 0, y: 1}
- name: varicodedecoder_panel_return
  from: {chip_port: {chip: 0, port: x1_in}}
  to: {block: varicodedecoder, port: char}
  route:
  - {x: 0, y: 11}
  - {x: 0, y: 10}
  entry_override: 26
- name: in_to_xo
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: varicodeencoder_xover, port: in}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  - {x: 2, y: 0}
  - {x: 3, y: 0}
  - {x: 4, y: 0}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 8, y: 1}
  - {x: 8, y: 2}
  - {x: 8, y: 3}
  - {x: 8, y: 4}
  - {x: 8, y: 5}
  - {x: 8, y: 6}
  stream_id: tx
- name: xo_to_ctl
  from: {block: varicodeencoder_xover, port: out}
  to: {block: varicodeencoder, port: in}
  route:
  - {x: 8, y: 6}
  - {x: 8, y: 7}
  - {x: 8, y: 8}
  - {x: 8, y: 9}
  - {x: 8, y: 10}
  - {x: 8, y: 11}
- name: egress_to_xo
  from: {block: raisedcosineenvelope, port: out}
  to: {block: varicodeencoder_xover, port: in}
  route:
  - {x: 7, y: 3}
  - {x: 7, y: 4}
  - {x: 7, y: 5}
  - {x: 7, y: 6}
  - {x: 8, y: 6}
  entry_override: 15
- name: xo_to_out
  from: {block: varicodeencoder_xover, port: out}
  to: {chip_port: {chip: 0, port: x16_out}}
  route:
  - {x: 8, y: 6}
  - {x: 9, y: 6}
  - {x: 9, y: 5}
  - {x: 9, y: 4}
  - {x: 9, y: 3}
  - {x: 9, y: 2}
  - {x: 9, y: 1}
  - {x: 9, y: 0}
  out_tag: 10
- name: rxctl_to_panel
  from: {block: varicodedecoder, port: out}
  to: {chip_port: {chip: 0, port: x1_out}}
  route:
  - {x: 9, y: 10}
  - {x: 9, y: 11}
- name: rx_in_to_tap
  from: {chip_port: {chip: 0, port: x16_in}}
  to: {block: bpskslicer, port: llr}
  route:
  - {x: 0, y: 0}
  - {x: 1, y: 0}
  - {x: 2, y: 0}
  - {x: 3, y: 0}
  - {x: 4, y: 0}
  - {x: 5, y: 0}
  - {x: 6, y: 0}
  - {x: 7, y: 0}
  - {x: 8, y: 0}
  - {x: 8, y: 1}
  - {x: 8, y: 2}
  - {x: 8, y: 3}
  - {x: 8, y: 4}
  - {x: 8, y: 5}
  - {x: 8, y: 6}
  - {x: 8, y: 7}
  - {x: 8, y: 8}
  stream_id: rx
- name: rx_egress
  from: {block: varicodedecoder, port: out}
  to: {block: varicodeencoder_xover, port: in}
  route:
  - {x: 1, y: 10}
  - {x: 1, y: 9}
  - {x: 1, y: 8}
  - {x: 1, y: 7}
  - {x: 1, y: 6}
  - {x: 2, y: 6}
  - {x: 3, y: 6}
  - {x: 4, y: 6}
  - {x: 5, y: 6}
  - {x: 6, y: 6}
  - {x: 7, y: 6}
  - {x: 8, y: 6}
  out_tag: 5
