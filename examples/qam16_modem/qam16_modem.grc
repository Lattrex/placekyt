options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Full-duplex 16-QAM modem authored in GNU Radio (GRC-first workflow).
      The TX chain (16-QAM symbol mapper -> complex upsampler -> complex RRC pulse
      shaper -> I/Q upconvert) and the coherent RX chain (complex RRC matched filter
      -> complex gain -> Mueller & Muller decision-directed symbol-timing recovery
      -> QAM16 decision-directed Costas -> QAM16 hard-decision slicer) live on ONE
      placeKYT array, sharing ONE input port (x16_in) and ONE output port (x16_out):
      both TX and RX source blocks map to x16_in and both sink blocks map to x16_out
      (the shared-port duplex, exactly like the QPSK modem). Built from the REAL DSP
      blocks so it IMPORTS into placeKYT (File -> Import GNURadio Flowgraph): every
      block gets placed + the logical nets are recovered, and the RX chain recovers
      the 4-bit 16-QAM symbols at BER 0 through simKYT. On-chip CO-PLACEMENT of the
      full duplex is up to the user: the M&M timing block is a large feedback block
      and the auto-router congests from a fresh import, so hand-place the chip (open
      a .kyt) rather than auto-P&R the whole duplex. NO carrier frequency offset:
      the hosted TX and RX share one clock, so the decision-directed M&M TED sees
      foff = 0 by construction.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: qam16_modem
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Full-duplex 16-QAM modem (TX + coherent RX on one array)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: carrier
  id: variable
  parameters:
    comment: TX carrier frequency
    value: '4000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 12]
    rotation: 0
    state: enabled
- name: gain
  id: variable
  parameters:
    comment: gain-stage the MF output to the 0.949 outer level
    value: '2.4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 12]
    rotation: 0
    state: enabled
- name: n_bits
  id: variable
  parameters:
    comment: TX bits in the burst (4/symbol) -> 1600 bits = 400 symbols
    value: '1600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 12]
    rotation: 0
    state: enabled
- name: n_syms
  id: variable
  parameters:
    comment: RX 16-QAM symbols in the burst
    value: '400'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: TX passband sample rate
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: TX samples per symbol
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: cgain
  id: kyttar_complex_gain
  parameters:
    affinity: ''
    alias: ''
    comment: gain-stage the MF output to the 0.949 outer level -- placed on chip
    device_id: '"kyttar_0"'
    gain: '2.4'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [744, 440.0]
    rotation: 0
    state: enabled
- name: costas
  id: kyttar_qam16_costas_loop
  parameters:
    affinity: ''
    alias: ''
    alpha_q15: '1024'
    beta_q15: '32'
    comment: 16-QAM decision-directed carrier recovery -- placed on chip
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 440.0]
    rotation: 0
    state: enabled
- name: import_stim
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: from gnuradio.kyttar import qam16_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 12]
    rotation: 0
    state: enabled
- name: mapper
  id: kyttar_qam16_symbol_mapper
  parameters:
    affinity: ''
    alias: ''
    comment: 16-QAM symbol mapper (4 bits -> constellation point) -- placed on chip
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 120.0]
    rotation: 0
    state: enabled
- name: mf
  id: kyttar_complex_rrc_matched_filter
  parameters:
    affinity: ''
    alias: ''
    alpha: '0.35'
    comment: Complex RRC matched filter front end -- placed on chip
    decimation: '1'
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    span: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 336.0]
    rotation: 0
    state: enabled
- name: mm
  id: kyttar_mm_timing_recovery
  parameters:
    affinity: ''
    alias: ''
    comment: M&M decision-directed symbol-timing recovery -- placed on chip
    damping: '1.0'
    device_id: '"kyttar_0"'
    loop_bw: '0.02'
    maxoutbuf: '0'
    minoutbuf: '0'
    sps: sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 352.0]
    rotation: 0
    state: enabled
- name: rrc
  id: kyttar_complex_rrc_matched_filter
  parameters:
    affinity: ''
    alias: ''
    alpha: '0.35'
    comment: Complex RRC pulse shaper (matched-filter block reused) -- placed on chip
    decimation: '1'
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    span: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 120.0]
    rotation: 0
    state: enabled
- name: rx_iq
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: RX RRC 16-QAM I/Q burst (no carrier offset; same-chip TX); finite, no
      repeat
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: complex
    vector: stim.burst(n_syms)
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 368.0]
    rotation: 0
    state: enabled
- name: rx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: recovered symbols -> placeKYT chip x16_out (shared duplex port, stream
      'rx')
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'False'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 340.0]
    rotation: 0
    state: enabled
- name: rx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: stim.burst_len(n_syms)
    comment: RX I/Q burst -> placeKYT chip x16_in (shared duplex port, stream 'rx')
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'yes'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 340.0]
    rotation: 0
    state: enabled
- name: rx_syms
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: recovered 4-bit 16-QAM symbols from the chip x16_out (stream 'rx')
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: recovered symbol
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Recovered 16-QAM symbols"'
    nconnections: '1'
    size: stim.rx_syms_points(n_syms)
    srate: '1'
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: symbol
    ymax: '15'
    ymin: '0'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1696, 440.0]
    rotation: 0
    state: enabled
- name: slicer
  id: kyttar_qam16_slicer
  parameters:
    affinity: ''
    alias: ''
    comment: 16-QAM hard-decision slicer (recovered 4-bit symbol) -- placed on chip
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1272, 448.0]
    rotation: 0
    state: enabled
- name: tx_bits
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: TX bit stimulus (one finite burst -> EOF dispatches it; no repeat)
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: float
    vector: stim.tx_bits(n_bits)
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [88, 168.0]
    rotation: 0
    state: enabled
- name: tx_passband
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: "TX passband (real) \u2014 recovered from the chip x16_out (stream 'tx')"
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: Signal 1
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"TX passband (real)"'
    nconnections: '1'
    size: stim.tx_pb_points(n_bits)
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1680, 208.0]
    rotation: 0
    state: enabled
- name: tx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: TX passband -> placeKYT chip x16_out (shared duplex port, stream 'tx')
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'False'
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 100.0]
    rotation: 0
    state: enabled
- name: tx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: n_bits
    comment: TX bits -> placeKYT chip x16_in (shared duplex port, stream 'tx')
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'yes'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 148.0]
    rotation: 0
    state: enabled
- name: up
  id: kyttar_complex_upsampler
  parameters:
    affinity: ''
    alias: ''
    comment: Complex (I/Q) zero-stuff upsampler (sps) -- placed on chip
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    sps: sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 240.0]
    rotation: 0
    state: enabled
- name: upc
  id: kyttar_iq_upconvert
  parameters:
    affinity: ''
    alias: ''
    comment: I/Q upconvert to real passband -- placed on chip
    device_id: '"kyttar_0"'
    frequency: '4000'
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1184, 224.0]
    rotation: 0
    state: enabled

connections:
- [cgain, '0', mm, '0']
- [costas, '0', slicer, '0']
- [mapper, '0', up, '0']
- [mf, '0', cgain, '0']
- [mm, '0', costas, '0']
- [rrc, '0', upc, '0']
- [rx_iq, '0', rx_src, '0']
- [rx_sink, '0', rx_syms, '0']
- [rx_src, '0', mf, '0']
- [slicer, '0', rx_sink, '0']
- [tx_bits, '0', tx_src, '0']
- [tx_sink, '0', tx_passband, '0']
- [tx_src, '0', mapper, '0']
- [up, '0', rrc, '0']
- [upc, '0', tx_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
