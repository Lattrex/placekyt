options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'ROBUST RX — coarse frequency recovery on one placeKYT array. One
      raised-cosine BPSK burst carries a LARGE carrier offset (0.18 cycles/sample,
      far beyond a Costas loop''s pull-in) into TWO placed receiver chains: ''rx'' =
      FLL band-edge (coarse frequency recovery) -> Costas(order 2) -> BPSK slicer,
      which LOCKS and recovers the bits; ''ctl'' = the same Costas -> slicer WITHOUT
      the FLL (the classic coherent chain''s carrier-recovery core), which cannot
      pull the offset — its recovered bits are garbage. The on-screen story: at
      real-world frequency offsets the old chain dies, the FLL-fronted one locks.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: robust_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Robust RX — FLL coarse frequency recovery vs Costas-only
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: import_stim
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: from gnuradio.kyttar import robust_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 68]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: display sample rate (scope axis only)
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: n_syms
  id: variable
  parameters:
    comment: BPSK symbols in the burst
    value: '600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: complex samples per burst (2 sps)
    value: stim.n_rx(n_syms)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 12]
    rotation: 0
    state: enabled
- name: rx_iq
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'RC-shaped BPSK burst, carrier offset foff = 0.18 cyc/sample (far
      beyond Costas pull-in); finite, no repeat'
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: complex
    vector: stim.rx_burst(n_syms)
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 220]
    rotation: 0
    state: enabled
- name: input_scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: 'the offset burst as the antenna sees it (I and Q spinning at 0.18 cyc/sample)'
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: Signal 1
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"RF burst (foff = 0.18 cyc/sample)"'
    nconnections: '1'
    size: burst_len - 16
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: level
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 420]
    rotation: 0
    state: enabled
- name: fll_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: 'the offset burst -> chip x16_in (stream ''rx'': FLL -> Costas -> slicer)'
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 196]
    rotation: 0
    state: enabled
- name: fll
  id: kyttar_fll_band_edge
  parameters:
    affinity: ''
    alias: ''
    bandwidth: '0.1'
    comment: "coarse frequency recovery (band-edge FLL) — placed on chip"
    device_id: '"kyttar_0"'
    filter_size: '17'
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: '0.35'
    samps_per_sym: '2.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [540, 180]
    rotation: 0
    state: enabled
- name: costas
  id: kyttar_costas_loop
  parameters:
    affinity: ''
    alias: ''
    comment: "fine carrier recovery (BPSK Costas) — placed on chip"
    damping: '1.0'
    device_id: '"kyttar_0"'
    loop_bw: '0.05'
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 188]
    rotation: 0
    state: enabled
- name: slicer
  id: kyttar_bpsk_slicer
  parameters:
    affinity: ''
    alias: ''
    comment: "hard bit decisions — placed on chip"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    out_mode: '"bit"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 196]
    rotation: 0
    state: enabled
- name: slicer_b2f
  id: blocks_uchar_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1140, 220]
    rotation: 0
    state: enabled
- name: rx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: 'recovered bits <- chip x16_out (stream ''rx''); a complex-input chain
      emits RAW word floats (the receiver convention), so the 0/1 bits plot directly'
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'True'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1300, 196]
    rotation: 0
    state: enabled
- name: fll_bits_scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: 'the FLL-fronted chain LOCKS: clean hard bits after the ~150-symbol acquisition'
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: Signal 1
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Recovered bits — FLL + Costas (locks)"'
    nconnections: '1'
    size: stim.n_rx_bits(n_syms)
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: bit
    ymax: '1.5'
    ymin: '-0.5'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1660, 180]
    rotation: 0
    state: enabled
- name: ctl_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: 'the SAME offset burst -> chip x16_in (stream ''ctl'': Costas -> slicer,
      NO FLL — the negative control)'
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    pipelined: 'no'
    port_name: '"x16_in"'
    schedule: '"interleaved"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"ctl"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 560]
    rotation: 0
    state: enabled
- name: ctl_costas
  id: kyttar_costas_loop
  parameters:
    affinity: ''
    alias: ''
    comment: "the OLD chain: Costas alone (pull-in ~0.12 cyc/sample — 0.18 is out of reach)"
    damping: '1.0'
    device_id: '"kyttar_0"'
    loop_bw: '0.05'
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [540, 552]
    rotation: 0
    state: enabled
- name: ctl_slicer
  id: kyttar_bpsk_slicer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    out_mode: '"bit"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 560]
    rotation: 0
    state: enabled
- name: ctl_b2f
  id: blocks_uchar_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 584]
    rotation: 0
    state: enabled
- name: ctl_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: 'garbage bits <- chip x16_out (stream ''ctl''); raw word floats, 0/1 plots directly'
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    in_type: float
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'True'
    stream_id: '"ctl"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1140, 560]
    rotation: 0
    state: enabled
- name: ctl_bits_scope
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: red
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: 'the Costas-only chain NEVER locks at this offset: the bits churn (BER ~0.2)'
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: Signal 1
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Recovered bits — Costas only (fails)"'
    nconnections: '1'
    size: stim.n_rx_bits(n_syms)
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: bit
    ymax: '1.5'
    ymin: '-0.5'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1480, 544]
    rotation: 0
    state: enabled

connections:
- [rx_iq, '0', input_scope, '0']
- [rx_iq, '0', fll_src, '0']
- [rx_iq, '0', ctl_src, '0']
- [fll_src, '0', fll, '0']
- [fll, '0', costas, '0']
- [costas, '0', slicer, '0']
- [slicer, '0', slicer_b2f, '0']
- [slicer_b2f, '0', rx_sink, '0']
- [rx_sink, '0', fll_bits_scope, '0']
- [ctl_src, '0', ctl_costas, '0']
- [ctl_costas, '0', ctl_slicer, '0']
- [ctl_slicer, '0', ctl_b2f, '0']
- [ctl_b2f, '0', ctl_sink, '0']
- [ctl_sink, '0', ctl_bits_scope, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
