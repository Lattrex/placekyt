    device_id: '"kyttar_0"'
    gain: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1384, 504.0]
    rotation: 0
    state: enabled
- name: import_stim
