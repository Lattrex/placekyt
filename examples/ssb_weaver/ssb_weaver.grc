options:
  parameters:
    author: Kyttar
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "FULL on-chip SSB Weaver TRANSCEIVER built from REAL blocks (4 real\
      \ multipliers + a subtract per half, exactly the Weaver diagram). audio ->\
      \ NCO(fa) mixers -> 2x LowPass -> NCO(fc) mixers -> Subtract [SSB] -> NCO(fc)\
      \ mixers -> 2x LowPass -> NCO(fa) mixers -> Subtract -> Gain -> recovered\
      \ audio. Imports into placeKYT: two clean real filaments, no complex-block\
      \ fan-in. Run as GNURadio Server in placeKYT + Execute here to stream audio."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ssb_weaver_transceiver
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "SSB Weaver transceiver (on-chip, real blocks) — audio in vs recovered"
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:

- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled

- name: n_samp
  id: variable
  parameters:
    comment: audio burst length
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled

- name: server_port
  id: variable
  parameters:
    comment: placeKYT GNURadio-server port
    value: '58950'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 12]
    rotation: 0
    state: enabled

- name: import_stim
  id: import
  parameters:
    imports: from gnuradio.kyttar import ssb_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 12]
    rotation: 0
    state: enabled

- name: tone
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.5'
    comment: ''
    freq: '800'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SIN_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 140]
    rotation: 0
    state: enabled

- name: tone2
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.3'
    comment: ''
    freq: '1800'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SIN_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 260]
    rotation: 0
    state: enabled

- name: audio
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'input audio (2 tones)'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 200]
    rotation: 0
    state: enabled

- name: thr
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 208]
    rotation: 0
    state: enabled

- name: tx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: n_samp
    comment: 'audio -> chip x16_in (TX chain, stream tx)'
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 180]
    rotation: 0
    state: enabled

- name: tx_f2c
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: 'audio -> I (Q=0)'
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 180]
    rotation: 0
    state: enabled

- name: tx_q0
  id: blocks_null_source
  parameters:
    affinity: ''
    alias: ''
    type: 'float'
    bus_structure_source: '[[0,],]'
    comment: 'Q = 0'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '1'
    sizeof_stream_item: 'gr.sizeof_float'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 260]
    rotation: 0
    state: enabled

- name: tx_ma
  id: kyttar_complex_mixer
  parameters:
    affinity: ''
    alias: ''
    amplitude: '1.0'
    comment: ''
    device_id: '"kyttar_0"'
    frequency: -1500.0
    offset: '0.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    phase: -9.130253649495335
    sample_rate: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 180]
    rotation: 0
    state: enabled

- name: tx_lp
  id: kyttar_complex_low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: 1200.0
    device_id: '"kyttar_0"'
    gain: '0.9'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    transition_width: 2500.0
    window: '"hamming"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 180]
    rotation: 0
    state: enabled

- name: tx_up
  id: kyttar_iq_upconvert
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    frequency: 6000.0
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1360, 180]
    rotation: 0
    state: enabled

- name: tx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: 'SSB passband <- x16_out (TX chain, stream tx)'
    device_id: '"kyttar_0"'
    num_channels: '1'
    port_name: '"x16_out"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1580, 180]
    rotation: 0
    state: enabled

- name: ssb_rf
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'RX input: the SSB passband (same audio); finite, no repeat'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vector: stim.ssb_passband(n_samp)
    repeat: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 340]
    rotation: 0
    state: enabled

- name: rx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: n_samp
    comment: 'SSB passband -> chip x16_in (RX chain, stream rx)'
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1760, 340]
    rotation: 0
    state: enabled

- name: rx_f2c
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: 'passband -> I (Q=0)'
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1920, 340]
    rotation: 0
    state: enabled

- name: rx_q0
  id: blocks_null_source
  parameters:
    affinity: ''
    alias: ''
    type: 'float'
    bus_structure_source: '[[0,],]'
    comment: 'Q = 0'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '1'
    sizeof_stream_item: 'gr.sizeof_float'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1920, 420]
    rotation: 0
    state: enabled

- name: rx_mc
  id: kyttar_complex_mixer
  parameters:
    affinity: ''
    alias: ''
    amplitude: '1.0'
    comment: ''
    device_id: '"kyttar_0"'
    frequency: -6000.0
    offset: '0.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    phase: -20.02765316663493
    sample_rate: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1980, 340]
    rotation: 0
    state: enabled

- name: rx_lp
  id: kyttar_complex_low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: 1200.0
    device_id: '"kyttar_0"'
    gain: '0.9'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    transition_width: 2500.0
    window: '"hamming"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2200, 340]
    rotation: 0
    state: enabled

- name: rx_up
  id: kyttar_iq_upconvert
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    frequency: 1500.0
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2440, 340]
    rotation: 0
    state: enabled

- name: g4
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    comment: 'Weaver 1/4 -> x4'
    device_id: '"kyttar_0"'
    gain: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2760, 340]
    rotation: 0
    state: enabled

- name: rx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: 'recovered audio <- x16_out (RX chain, stream rx)'
    device_id: '"kyttar_0"'
    num_channels: '1'
    port_name: '"x16_out"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2940, 340]
    rotation: 0
    state: enabled

- name: in_sink
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: 'input audio'
    legend: 'True'
    marker1: '-1'
    name: "Input audio"
    nconnections: '1'
    size: n_samp
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: ''
    type: float
    update_time: '0.10'
    width1: '1'
    ylabel: 'Amplitude'
    ymax: '1'
    ymin: '-1'
    yunit: ''
    grid_color1: 'blue'
    alpha1: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 40]
    rotation: 0
    state: enabled

- name: out_sink
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'True'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: 'recovered audio'
    legend: 'True'
    marker1: '-1'
    name: "Recovered audio (chip out)"
    nconnections: '1'
    size: n_samp
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: ''
    type: float
    update_time: '0.10'
    width1: '1'
    ylabel: 'Amplitude'
    ymax: '1'
    ymin: '-1'
    yunit: ''
    grid_color1: 'green'
    alpha1: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2940, 200]
    rotation: 0
    state: enabled

- name: pb_sink
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'True'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: 'SSB passband'
    legend: 'True'
    marker1: '-1'
    name: "TX passband (SSB, chip out)"
    nconnections: '1'
    size: n_samp
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: ''
    type: float
    update_time: '0.10'
    width1: '1'
    ylabel: 'Amplitude'
    ymax: '1'
    ymin: '-1'
    yunit: ''
    grid_color1: 'red'
    alpha1: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1580, 40]
    rotation: 0
    state: enabled

connections:
- [tone, '0', audio, '0']
- [tone2, '0', audio, '1']
- [audio, '0', thr, '0']
- [thr, '0', in_sink, '0']
- [thr, '0', tx_src, '0']
- [tx_src, '0', tx_f2c, '0']
- [tx_q0, '0', tx_f2c, '1']
- [tx_f2c, '0', tx_ma, '0']
- [tx_ma, '0', tx_lp, '0']
- [tx_lp, '0', tx_up, '0']
- [tx_up, '0', tx_sink, '0']
- [tx_sink, '0', pb_sink, '0']
- [ssb_rf, '0', rx_src, '0']
- [rx_src, '0', rx_f2c, '0']
- [rx_q0, '0', rx_f2c, '1']
- [rx_f2c, '0', rx_mc, '0']
- [rx_mc, '0', rx_lp, '0']
- [rx_lp, '0', rx_up, '0']
- [rx_up, '0', g4, '0']
- [g4, '0', rx_sink, '0']
- [rx_sink, '0', out_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
