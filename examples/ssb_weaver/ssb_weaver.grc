options:
  parameters:
    author: Kyttar
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "FULL on-chip SSB Weaver TRANSCEIVER (real blocks -> imports into\
      \ placeKYT). audio -> ComplexMixer(-fa) -> ComplexToFloat -> 2x LowPass ->\
      \ IQUpconvert(fc) [SSB] -> ComplexMixer(-fc) -> ComplexToFloat -> 2x LowPass\
      \ -> IQUpconvert(fa) -> Gain -> recovered audio. Import here to auto-P&R the\
      \ 10-block chain onto the chip and SEE where the router struggles; or Run as\
      \ GNURadio Server in placeKYT + Execute here to stream audio through the chip."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ssb_weaver_transceiver
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "SSB Weaver transceiver (on-chip) — audio in vs recovered audio"
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:

- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled

- name: n_samp
  id: variable
  parameters:
    comment: audio burst length
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled

- name: server_port
  id: variable
  parameters:
    comment: placeKYT GNURadio-server port
    value: '58950'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 12]
    rotation: 0
    state: enabled

- name: tone
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.5'
    comment: ''
    freq: '800'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SIN_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 140]
    rotation: 0
    state: enabled

- name: tone2
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.3'
    comment: ''
    freq: '1800'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SIN_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 260]
    rotation: 0
    state: enabled

- name: audio
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'input audio (2 tones)'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 200]
    rotation: 0
    state: enabled

- name: thr
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 208]
    rotation: 0
    state: enabled

- name: msrc
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: n_samp
    comment: 'audio -> chip x16_in (batch)'
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 200]
    rotation: 0
    state: enabled

- name: tx_mix
  id: kyttar_complex_mixer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    frequency: -1500.0
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 180]
    rotation: 0
    state: enabled

- name: tx_split
  id: kyttar_complex_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 188]
    rotation: 0
    state: enabled

- name: tx_lpi
  id: kyttar_low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: 1200.0
    decimation: '1'
    device_id: '"kyttar_0"'
    gain: '1'
    interpolation: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: 32000.0
    transition_width: 2500.0
    window: "hamming"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 140]
    rotation: 0
    state: enabled

- name: tx_lpq
  id: kyttar_low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: 1200.0
    decimation: '1'
    device_id: '"kyttar_0"'
    gain: '1'
    interpolation: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: 32000.0
    transition_width: 2500.0
    window: "hamming"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 260]
    rotation: 0
    state: enabled

- name: tx_up
  id: kyttar_iq_upconvert
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    frequency: 6000.0
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1220, 188]
    rotation: 0
    state: enabled

- name: rx_mix
  id: kyttar_complex_mixer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    frequency: -6000.0
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 180]
    rotation: 0
    state: enabled

- name: rx_split
  id: kyttar_complex_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1580, 188]
    rotation: 0
    state: enabled

- name: rx_lpi
  id: kyttar_low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: 1200.0
    decimation: '1'
    device_id: '"kyttar_0"'
    gain: '1'
    interpolation: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: 32000.0
    transition_width: 2500.0
    window: "hamming"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1720, 140]
    rotation: 0
    state: enabled

- name: rx_lpq
  id: kyttar_low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: 1200.0
    decimation: '1'
    device_id: '"kyttar_0"'
    gain: '1'
    interpolation: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: 32000.0
    transition_width: 2500.0
    window: "hamming"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1720, 260]
    rotation: 0
    state: enabled

- name: rx_up
  id: kyttar_iq_upconvert
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_id: '"kyttar_0"'
    frequency: 1500.0
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: 32000.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1900, 188]
    rotation: 0
    state: enabled

- name: g4
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    comment: 'Weaver 1/4 -> x4'
    device_id: '"kyttar_0"'
    gain: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2080, 188]
    rotation: 0
    state: enabled

- name: msink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: 'recovered audio <- x16_out'
    device_id: '"kyttar_0"'
    num_channels: '1'
    port_name: '"x16_out"'
    server_host: '"127.0.0.1"'
    server_port: server_port
    stream_id: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2260, 200]
    rotation: 0
    state: enabled

- name: in_sink
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: 'input audio'
    legend: 'True'
    marker1: '-1'
    name: "Input audio"
    nconnections: '1'
    size: n_samp
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: ''
    type: float
    update_time: '0.10'
    width1: '1'
    ylabel: 'Amplitude'
    ymax: '1'
    ymin: '-1'
    yunit: ''
    grid_color1: 'blue'
    alpha1: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 40]
    rotation: 0
    state: enabled

- name: out_sink
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'True'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: 'recovered audio'
    legend: 'True'
    marker1: '-1'
    name: "Recovered audio (chip out)"
    nconnections: '1'
    size: n_samp
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: ''
    type: float
    update_time: '0.10'
    width1: '1'
    ylabel: 'Amplitude'
    ymax: '1'
    ymin: '-1'
    yunit: ''
    grid_color1: 'green'
    alpha1: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2260, 40]
    rotation: 0
    state: enabled

connections:
- [tone, '0', audio, '0']
- [tone2, '0', audio, '1']
- [audio, '0', thr, '0']
- [thr, '0', msrc, '0']
- [thr, '0', in_sink, '0']
- [msrc, '0', tx_mix, '0']
- [tx_mix, '0', tx_split, '0']
- [tx_split, '0', tx_lpi, '0']
- [tx_split, '1', tx_lpq, '0']
- [tx_lpi, '0', tx_up, '0']
- [tx_lpq, '0', tx_up, '1']
- [tx_up, '0', rx_mix, '0']
- [rx_mix, '0', rx_split, '0']
- [rx_split, '0', rx_lpi, '0']
- [rx_split, '1', rx_lpq, '0']
- [rx_lpi, '0', rx_up, '0']
- [rx_lpq, '0', rx_up, '1']
- [rx_up, '0', g4, '0']
- [g4, '0', msink, '0']
- [msink, '0', out_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
