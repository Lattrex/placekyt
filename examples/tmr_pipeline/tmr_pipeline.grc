options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'TRIPLE-MODULAR REDUNDANCY on one placeKYT array, next to an ordinary
      single-path stream on the SAME die. A 256-byte ramp fans out to three identical
      identity workers (Stream Splitter relays); a depth-neutral fault injector
      (Kyttar Add Const) sits on EVERY arm with constants 0 / f / 0, so the f
      variable (one byte LSB in signal units, 1/32768) corrupts path B by exactly
      one word without changing any arm''s depth; set f to 0.0 for the healthy run.
      The TMR Voter tells the arms apart by arrival face, votes, and emits a
      2-word [value, status] packet per sample: with f=0 every packet is
      [ramp byte, 0]; with the fault every packet is [ramp byte, 2] — the value is STILL
      the correct ramp byte (TMR corrects the fault) and the status names path B.
      A second, independent stream rides the same array through a single Gain block
      (0.5x), demonstrating that redundancy is chosen PER PATH at place-and-route
      time: TMR for the safety-critical path, single-path for the rest, same die.
      Both kyttar sources set Output words = Raw (byte and status words are not
      Q15). Change f, re-import into placeKYT to rebuild, and re-run to compare.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: tmr_pipeline
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: TMR pipeline (triple-redundant path + single path, one array)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: f
  id: variable
  parameters:
    comment: 'fault injected on path B, in signal units. 3.0517578125e-05 = 1/32768
      = exactly ONE word LSB (all packets [byte, 2] - value still correct); 0.0 =
      healthy (all packets [byte, 0]). A float literal, NOT an expression: the
      placeKYT importer resolves a marker param through one variable lookup and
      keeps the block default for anything it cannot literal-coerce.'
    value: 3.0517578125e-05
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: burst_len
  id: variable
  parameters:
    comment: ramp length in bytes
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 320
    - 12
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: display rate for the time sinks
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 12
    rotation: 0
    state: enabled
- name: ramp_tmr
