    width9: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1320
    - 320
    rotation: 0
    state: enabled
connections:
- - tx_bits
  - '0'
  - tx_chip
  - '0'
- - tx_chip
  - '0'
  - f2c
  - '0'
- - tx_chip
  - '0'
  - pb_sink
  - '0'
- - f2c
  - '0'
  - mix
  - '0'
- - lo
  - '0'
  - mix
  - '1'
- - mix
  - '0'
  - skip
  - '0'
- - skip
  - '0'
  - keep
  - '0'
- - keep
  - '0'
  - rx_chip
  - '0'
- - keep
  - '0'
  - const_sink
  - '0'
- - rx_chip
  - '0'
  - bit_sink
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
