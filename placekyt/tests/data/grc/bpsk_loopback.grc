options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'ONE importable design of REAL Kyttar blocks. The TX chain (PSK mapper -> upsampler -> RRC -> I/Q upconvert) and the coherent RX chain (complex RRC matched filter -> Costas -> Gardner ->
      BPSK slicer) both live on ONE placeKYT array. GRC closes the loop: the TX passband leaves the chip, is downconverted to complex baseband in stock GR (the ''channel''), AWGN is added (noise_volt variable;
      0 = clean, BER 0), and it re-enters as the RX input -> recovered bits == transmitted bits. Raise noise_volt live to watch the constellation smear and the BER climb. Import into placeKYT (File -> Import
      GNURadio Flowgraph): all 8 DSP blocks place on the chip; the GR downconvert + AWGN channel are dropped. Then ''Run as GNURadio Server'' + Execute this graph.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: bpsk_loopback
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: BPSK transceiver loopback (TX -> upconvert -> downconvert -> RX) on one chip
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: sps
  id: variable
  parameters:
    comment: TX samples per symbol
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: TX passband sample rate
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 320
    - 12
    rotation: 0
    state: enabled
- name: carrier
  id: variable
  parameters:
    comment: TX carrier frequency
    value: '4000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 12
    rotation: 0
    state: enabled
- name: import_stim
  id: import
  parameters:
    imports: from gnuradio.kyttar import modem_demo_stim as stim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 12
    rotation: 0
    state: enabled
- name: n_syms
  id: variable
  parameters:
    comment: RX symbols in the burst
    value: '120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 12
    rotation: 0
    state: enabled
- name: n_bits
  id: variable
  parameters:
    comment: TX bits in the burst
    value: '64'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 800
    - 12
    rotation: 0
    state: enabled
- name: tx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    comment: TX bits -> placeKYT chip x16_in (shared duplex port, stream 'tx')
    complex_in: float
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"tx"'
    burst_len: n_bits
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 40
    - 120
    rotation: 0
    state: enabled
- name: mapper
  id: kyttar_psk_symbol_mapper
  parameters:
    affinity: ''
    alias: ''
    comment: "PSK symbol mapper (BPSK) \u2014 placed on chip"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    modulation: '"bpsk"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 248
    - 116
    rotation: 0
    state: enabled
- name: up
  id: kyttar_upsampler
  parameters:
    affinity: ''
    alias: ''
    comment: "Zero-stuff upsampler (sps) \u2014 placed on chip"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    sps: sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 448
    - 116
    rotation: 0
    state: enabled
- name: rrc
  id: kyttar_rrc_pulse_shaper
  parameters:
    affinity: ''
    alias: ''
    alpha: '0.35'
    comment: "RRC pulse shaper \u2014 placed on chip"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    span: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 624
    - 116
    rotation: 0
    state: enabled
- name: upc
  id: kyttar_iq_upconvert
  parameters:
    affinity: ''
    alias: ''
    comment: "I/Q upconvert to real passband \u2014 placed on chip"
    device_id: '"kyttar_0"'
    frequency: carrier
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 832
    - 100
    rotation: 0
    state: enabled
- name: tx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: TX passband -> placeKYT chip x16_out (shared duplex port, stream 'tx')
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'False'
    stream_id: '"tx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1040
    - 120
    rotation: 0
    state: enabled
- name: rx_src
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    comment: RX I/Q baseband (from the downconverted TX passband) -> matched filter
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: '58950'
    stream_id: '"rx"'
    burst_len: n_bits*4//2 - 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 40
    - 320
    rotation: 0
    state: enabled
- name: mf
  id: kyttar_complex_rrc_matched_filter
  parameters:
    affinity: ''
    alias: ''
    alpha: '0.35'
    comment: "Complex RRC matched filter front end \u2014 placed on chip"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    span: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 248
    - 308
    rotation: 0
    state: enabled
- name: costas
  id: kyttar_costas_loop
  parameters:
    affinity: ''
    alias: ''
    comment: "Complex Costas carrier recovery \u2014 placed on chip"
    damping: '1.0'
    device_id: '"kyttar_0"'
    loop_bw: '0.05'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 464
    - 308
    rotation: 0
    state: enabled
- name: gardner
  id: kyttar_gardner_ted
  parameters:
    affinity: ''
    alias: ''
    comment: "Gardner timing recovery \u2014 placed on chip"
    device_id: '"kyttar_0"'
    ki: '1'
    kp: '3'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 672
    - 324
    rotation: 0
    state: enabled
- name: slicer
  id: kyttar_bpsk_slicer
  parameters:
    affinity: ''
    alias: ''
    comment: "BPSK slicer (recovered bits) \u2014 placed on chip"
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 864
    - 324
    rotation: 0
    state: enabled
- name: rx_sink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: recovered bits -> placeKYT chip x16_out (shared duplex port, stream 'rx')
    device_id: '"kyttar_0"'
    hold_secs: '8.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_port: '58950'
    server_repeat: 'False'
    stream_id: '"rx"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1056
    - 324
    rotation: 0
    state: enabled
- name: tx_bits
  id: blocks_vector_source_x
  parameters:
    comment: TX bit stimulus (one finite burst -> EOF dispatches it; no repeat)
    type: float
    vector: stim.tx_bits(n_bits)
    repeat: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 40
    - 16
    rotation: 0
    state: enabled
- name: tx_passband
  id: qtgui_time_sink_x
  parameters:
    comment: "TX passband (real) \u2014 recovered from the chip x16_out (stream 'tx')"
    type: float
    name: '"TX passband (real)"'
    nconnections: '1'
    ylabel: amplitude
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1264
    - 112
    rotation: 0
    state: enabled
- name: rx_bits
  id: qtgui_time_sink_x
  parameters:
    comment: "recovered bits \u2014 from the chip x16_out (stream 'rx')"
    type: float
    name: '"Recovered bits"'
    nconnections: '1'
    ylabel: bit
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1264
    - 316
    rotation: 0
    state: enabled
- name: f2c
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: TX passband (real) -> complex (imag = 0)
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1264
    - 196
    rotation: 0
    state: enabled
- name: lo
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '2.0'
    comment: LO = 2*exp(-j*2*pi*(carrier/samp_rate)*n) (image-reject gain 2.0); skiphead(1) absorbs the upconvert NCO increment-before-emit.
    freq: -carrier
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1264
    - 320
    rotation: 0
    state: enabled
- name: mix
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: downconvert to complex baseband
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1456
    - 204
    rotation: 0
    state: enabled
- name: skip
  id: blocks_skiphead
  parameters:
    affinity: ''
    alias: ''
    comment: bb[1:] (exact 1-sample delay; not blocks.delay)
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '1'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1640
    - 204
    rotation: 0
    state: enabled
- name: keep
  id: blocks_keep_one_in_n
  parameters:
    affinity: ''
    alias: ''
    comment: bb[::2] (decimate TX sps 4 -> RX sps 2)
    maxoutbuf: '0'
    minoutbuf: '0'
    n: '2'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1816
    - 204
    rotation: 0
    state: enabled
- name: noise_volt
  id: variable
  parameters:
    comment: AWGN std-dev on the baseband I/Q (0 = clean). Raise live to degrade BER + smear the constellation.
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1056
    - 12
    rotation: 0
    state: enabled
- name: awgn
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_volt
    comment: complex AWGN (channel noise)
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1816
    - 432
    rotation: 0
    state: enabled
- name: chan
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: baseband + AWGN -> noisy RX input
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2008
    - 204
    rotation: 0
    state: enabled
- name: const_sink
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    color1: '"blue"'
    color10: '"red"'
    color2: '"red"'
    color3: '"red"'
    color4: '"red"'
    color5: '"red"'
    color6: '"red"'
    color7: '"red"'
    color8: '"red"'
    color9: '"red"'
    comment: downconverted BPSK constellation (2 clean points)
    grid: 'False'
    gui_hint: ''
    label1: baseband
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '0'
    marker10: '0'
    marker2: '0'
    marker3: '0'
    marker4: '0'
    marker5: '0'
    marker6: '0'
    marker7: '0'
    marker8: '0'
    marker9: '0'
    name: '"Downconverted constellation"'
    nconnections: '1'
    size: '1024'
    style1: '0'
    style10: '0'
    style2: '0'
    style3: '0'
    style4: '0'
    style5: '0'
    style6: '0'
    style7: '0'
    style8: '0'
    style9: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_MODE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1816
    - 320
    rotation: 0
    state: enabled
connections:
- - costas
  - '0'
  - gardner
  - '0'
- - gardner
