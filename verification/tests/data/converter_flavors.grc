options:
  parameters:
    author: Lattrex
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "All-flavors float<->complex converter demo, structured so it RUNS\
      \ end to end on a placeKYT-hosted chip. ONE complex stream is fed in, split to\
      \ two real rails, gained, recombined, and read back — so every float/complex\
      \ converter is exercised AND the output is directly verifiable (identity chain:\
      \ the mixers are pass-through, so chip output == input). Chain: complex source\
      \ (x16_in) -> complex mixer -> blocks_complex_to_float (split I/Q) -> two real\
      \ gains -> blocks_float_to_complex (recombine the two on-chip real rails via the\
      \ DualFloatToComplex block) -> complex mixer -> blocks_complex_to_real -> real\
      \ gain -> sink (x16_out). The two reals feeding the recombine come from the\
      \ on-chip c2f split (a normal fan-in), NOT two independent input ports, so no\
      \ input splitter is needed. Run: 'Run as GNURadio Server' in placeKYT, set\
      \ server_port below to the printed port, then Execute here; the time sink\
      \ overlays the input against the chip output so the round trip is visible."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: converter_flavors
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Float<->Complex converter flavors (runnable identity chain)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [200,
      12], rotation: 0, state: enabled}
- name: burst_len
  id: variable
  parameters:
    comment: float samples dispatched to the chip in one batch RPC
    value: '256'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [320,
      12], rotation: 0, state: enabled}
- name: server_port
  id: variable
  parameters:
    comment: placeKYT prints this on "Run as GNURadio Server"
    value: '58950'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [440,
      12], rotation: 0, state: enabled}
# --- stimulus: one bounded complex burst (a slow I/Q sine) --------------------
- name: src_wave
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.7'
    comment: complex rotating phasor stimulus
    freq: '500'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    type: complex
    waveform: analog.GR_COS_WAVE
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [40,
      140], rotation: 0, state: enabled}
- name: src_head
  id: blocks_head
  parameters:
    comment: bound the stream to one burst so the batch source dispatches once
    num_items: burst_len
    type: complex
    vlen: '1'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [240,
      140], rotation: 0, state: enabled}
- name: msrc
  id: kyttar_source
  parameters:
    affinity: ''
    alias: ''
    burst_len: burst_len
    comment: complex stimulus -> placeKYT chip x16_in (batch)
    complex_in: complex
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_in"'
    server_host: '"127.0.0.1"'
    server_port: server_port
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [420,
      132], rotation: 0, state: enabled}
# --- (A) complex DSP stage (pass-through mixer) ------------------------------
- name: mix1
  id: kyttar_complex_mixer
  parameters:
    affinity: ''
    alias: ''
    amplitude: '1.0'
    comment: pass-through (freq 0)
    device_id: '"kyttar_0"'
    frequency: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0.0'
    phase: '0.0'
    sample_rate: '32000'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [620,
      132], rotation: 0, state: enabled}
# --- (B) complex_to_float: split I and Q rails -------------------------------
- name: c2f
  id: blocks_complex_to_float
  parameters: {comment: split complex -> (I, Q), vlen: '1'}
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [820,
      132], rotation: 0, state: enabled}
- name: gain_i
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    comment: I rail
    device_id: '"kyttar_0"'
    gain: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1000,
      80], rotation: 0, state: enabled}
- name: gain_q
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    comment: Q rail
    device_id: '"kyttar_0"'
    gain: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1000,
      200], rotation: 0, state: enabled}
# --- (C) float_to_complex: recombine the two on-chip real rails (2-real) ------
- name: f2c
  id: blocks_float_to_complex
  parameters: {comment: recombine (I, Q) -> complex (DualFloatToComplex), vlen: '1'}
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1200,
      132], rotation: 0, state: enabled}
- name: mix2
  id: kyttar_complex_mixer
  parameters:
    affinity: ''
    alias: ''
    amplitude: '1.0'
    comment: pass-through (freq 0)
    device_id: '"kyttar_0"'
    frequency: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0.0'
    phase: '0.0'
    sample_rate: '32000'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1400,
      132], rotation: 0, state: enabled}
# --- (D) complex_to_real: drop Q, keep the recovered I -----------------------
- name: c2r
  id: blocks_complex_to_real
  parameters: {comment: complex -> real (I), vlen: '1'}
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1600,
      140], rotation: 0, state: enabled}
- name: gain_out
  id: kyttar_gain
  parameters:
    affinity: ''
    alias: ''
    comment: output gain
    device_id: '"kyttar_0"'
    gain: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1780,
      132], rotation: 0, state: enabled}
- name: msink
  id: kyttar_sink
  parameters:
    affinity: ''
    alias: ''
    comment: chip x16_out -> back to GRC
    device_id: '"kyttar_0"'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '1'
    port_name: '"x16_out"'
    server_host: '"127.0.0.1"'
    server_port: server_port
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1960,
      132], rotation: 0, state: enabled}
# --- observe: overlay chip output against the input I ------------------------
- name: c2f_ref
  id: blocks_complex_to_float
  parameters: {comment: reference I of the input for the overlay, vlen: '1'}
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [620,
      300], rotation: 0, state: enabled}
- name: time_sink
  id: qtgui_time_sink_x
  parameters:
    comment: input I (ref) vs chip output I
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: chip out (I)
    label2: input (I ref)
    legend: 'True'
    name: '"Converter chain: input I vs chip output (identity)"'
    nconnections: '2'
    size: '256'
    srate: samp_rate
    type: float
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    ylabel: Amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [2160,
      120], rotation: 0, state: enabled}

connections:
- [src_wave, '0', src_head, '0']
- [src_head, '0', msrc, '0']
- [msrc, '0', mix1, '0']
- [mix1, '0', c2f, '0']
- [c2f, '0', gain_i, '0']
- [c2f, '1', gain_q, '0']
- [gain_i, '0', f2c, '0']
- [gain_q, '0', f2c, '1']
- [f2c, '0', mix2, '0']
- [mix2, '0', c2r, '0']
- [c2r, '0', gain_out, '0']
- [gain_out, '0', msink, '0']
- [msink, '0', time_sink, '0']
- [src_head, '0', c2f_ref, '0']
- [c2f_ref, '0', time_sink, '1']

metadata:
  file_format: 1
  grc_version: 3.10.0
